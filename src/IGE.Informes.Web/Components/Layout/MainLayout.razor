@inherits LayoutComponentBase

@using IGE.Informes.Application.Common.Security
@using IGE.Informes.Infrastructure.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.DependencyInjection

@inject IServiceScopeFactory ScopeFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <span class="topbar-title">Surveillance Analytics System</span>
            <div class="topbar-search">
                <svg class="topbar-search-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.098zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" fill="currentColor" />
                </svg>
                <input type="search" class="topbar-search-input" placeholder="Buscar por código o matrícula…" />
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private const string RutaSetup2faObligatorio = "Account/ConfigurarDosFactoresObligatorio";

    // Defensa en profundidad: Login.razor ya redirige acá tras un login
    // exitoso sin 2FA para Admin/Supervisor, pero este chequeo evita que
    // el usuario navegue a mano a cualquier otra URL del sistema mientras
    // el setup obligatorio siga pendiente (ver docs/06-seguridad-
    // amenazas.md, sección "2FA obligatorio para Supervisor y Admin").
    protected override async Task OnInitializedAsync()
    {
        var currentPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?')[0];
        if (currentPath.StartsWith(RutaSetup2faObligatorio, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (!authState.User.Identity?.IsAuthenticated ?? true)
        {
            return;
        }

        // Scope propio (no el UserManager/AppDbContext inyectado en el scope del
        // circuito): páginas hijas disparan sus propias Queries/Commands contra el
        // mismo AppDbContext scoped en su OnInitializedAsync, que corre en paralelo
        // al de este layout — sin aislar el scope, dos operaciones concurrentes sobre
        // la misma instancia de DbContext tiran InvalidOperationException
        // ("A second operation was started on this context instance...").
        await using var scope = ScopeFactory.CreateAsyncScope();
        var userManager = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();

        var user = await userManager.GetUserAsync(authState.User);
        if (user is null || user.TwoFactorEnabled)
        {
            return;
        }

        var roles = await userManager.GetRolesAsync(user);
        if (roles.Contains(Roles.Admin) || roles.Contains(Roles.Supervisor))
        {
            NavigationManager.NavigateTo($"{RutaSetup2faObligatorio}?ReturnUrl={Uri.EscapeDataString(NavigationManager.Uri)}", forceLoad: false);
        }
    }
}
