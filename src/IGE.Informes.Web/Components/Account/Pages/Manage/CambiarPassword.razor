@page "/Account/Manage/CambiarPassword"
@attribute [Authorize]
@rendermode InteractiveServer

@using IGE.Informes.Application.Usuarios.Commands.CambiarPasswordPropia
@using MediatR
@inject ISender Sender

<PageTitle>Cambiar contraseña · IGE 4.0</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card">
            <h1 class="headline-md mb-3">Cambiar contraseña</h1>

            <div class="mb-3">
                <label class="label-md" for="passwordActual">Contraseña actual</label>
                <div class="input-group-password">
                    <input id="passwordActual" type="password" class="form-control" @bind="_passwordActual" autocomplete="current-password" disabled="@_procesando" />
                    <button type="button" class="btn-toggle-password" tabindex="-1" aria-label="Mostrar u ocultar contraseña">
                        <span class="bi bi-eye-toggle" aria-hidden="true"></span>
                    </button>
                </div>
            </div>

            <div class="mb-3">
                <label class="label-md" for="passwordNueva">Contraseña nueva (12+ caracteres)</label>
                <div class="input-group-password">
                    <input id="passwordNueva" type="password" class="form-control" @bind="_passwordNueva" autocomplete="new-password" disabled="@_procesando" />
                    <button type="button" class="btn-toggle-password" tabindex="-1" aria-label="Mostrar u ocultar contraseña">
                        <span class="bi bi-eye-toggle" aria-hidden="true"></span>
                    </button>
                </div>
            </div>

            <button type="button" class="btn-primary" @onclick="CambiarPasswordAsync" disabled="@_procesando">Confirmar</button>

            @if (_exito)
            {
                <div class="status-chip status-chip--safe mt-3">Contraseña actualizada correctamente.</div>
            }
            @if (_errorMessage is not null)
            {
                <div class="status-chip status-chip--alert mt-3">@_errorMessage</div>
            }
        </div>
    </div>
</div>

@code {
    private string _passwordActual = string.Empty;
    private string _passwordNueva = string.Empty;
    private bool _procesando;
    private bool _exito;
    private string? _errorMessage;

    private async Task CambiarPasswordAsync()
    {
        _errorMessage = null;
        _exito = false;
        _procesando = true;

        try
        {
            await Sender.Send(new CambiarPasswordPropiaCommand(_passwordActual, _passwordNueva));
            _passwordActual = string.Empty;
            _passwordNueva = string.Empty;
            _exito = true;
        }
        catch (FluentValidation.ValidationException ex)
        {
            _errorMessage = string.Join(" ", ex.Errors.Select(e => e.ErrorMessage));
        }
        catch (Exception)
        {
            _errorMessage = "No se pudo cambiar la contraseña. Verificá que la actual sea correcta y que la nueva cumpla la política mínima de 12 caracteres.";
        }
        finally
        {
            _procesando = false;
        }
    }
}
