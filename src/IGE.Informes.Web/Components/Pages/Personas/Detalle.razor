@page "/personas/{PersonaId:guid}"
@attribute [Authorize]
@using IGE.Informes.Application.Common.Dtos
@using IGE.Informes.Application.Personas.Commands.AgregarImagenPersona
@using IGE.Informes.Application.Personas.Commands.CambiarRolPersona
@using IGE.Informes.Application.Personas.Commands.IdentificarPersona
@using IGE.Informes.Application.Personas.Commands.QuitarImagenPersona
@using IGE.Informes.Application.Personas.Commands.VincularVehiculo
@using IGE.Informes.Application.Personas.Queries.ListarImagenesPersona
@using IGE.Informes.Application.Personas.Queries.ListarVehiculosVinculados
@using IGE.Informes.Application.Personas.Queries.ObtenerHistorialInformesPersona
@using IGE.Informes.Application.Personas.Queries.ObtenerPersonaPorId
@using IGE.Informes.Application.Vehiculos.Queries.BuscarVehiculos
@using IGE.Informes.Application.Vehiculos.Queries.ListarVehiculos
@using IGE.Informes.Domain.Entities
@using Microsoft.AspNetCore.Components.Forms
@using MediatR
@inject ISender Sender
@inject NavigationManager NavigationManager

<PageTitle>Detalle de Persona · IGE 4.0</PageTitle>

@if (!_cargado)
{
    <p class="body-md">Cargando...</p>
}
else if (_persona is null)
{
    <p class="body-md">No se encontró la persona solicitada.</p>
}
else
{
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h1 class="headline-md mb-1">@(_persona.Nombre ?? "Persona sin identificar")</h1>
            @if (_persona.Nombre is not null)
            {
                <StatusChip Texto="Identificada" Semantica="ChipSemantica.Safe" />
            }
            else
            {
                <StatusChip Texto="Sin identificar" Semantica="ChipSemantica.Neutral" />
            }
        </div>
        <a class="btn-secondary" href="personas">Volver al listado</a>
    </div>

    <div class="card mb-3">
        <h2 class="headline-sm mb-2">Datos generales</h2>
        <dl class="row mb-0">
            <dt class="col-sm-3 label-md">DNI</dt>
            <dd class="col-sm-9 mono-data">@(_persona.Dni ?? "—")</dd>

            <dt class="col-sm-3 label-md">Rol</dt>
            <dd class="col-sm-9 body-md">@_persona.Rol</dd>

            <dt class="col-sm-3 label-md">Características</dt>
            <dd class="col-sm-9 body-md">@(_persona.Caracteristicas ?? "—")</dd>
        </dl>
    </div>

    @if (_persona.Nombre is null)
    {
        <div class="card mb-3">
            <h2 class="headline-sm mb-2">Identificar persona</h2>
            <div class="mb-2">
                <label class="label-md" for="nombreIdentificar">Nombre</label>
                <input id="nombreIdentificar" class="form-control" @bind="_nombreIdentificar" />
            </div>
            <div class="mb-2">
                <label class="label-md" for="dniIdentificar">DNI (opcional)</label>
                <input id="dniIdentificar" class="form-control mono-data" @bind="_dniIdentificar" />
            </div>
            <button type="button" class="btn-primary" @onclick="IdentificarAsync" disabled="@_procesando">Confirmar identificación</button>
        </div>
    }

    <div class="card">
        <h2 class="headline-sm mb-2">Cambiar rol</h2>
        <div class="d-flex align-items-end gap-2">
            <select class="form-control" @bind="_rolSeleccionado">
                <option value="@RolPersona.Denunciante">Denunciante</option>
                <option value="@RolPersona.Damnificado">Damnificado</option>
                <option value="@RolPersona.Sospechoso">Sospechoso</option>
                <option value="@RolPersona.ConductorIdentificado">Conductor identificado</option>
                <option value="@RolPersona.Testigo">Testigo</option>
            </select>
            <button type="button" class="btn-secondary" @onclick="CambiarRolAsync" disabled="@_procesando">Confirmar</button>
        </div>
    </div>

    <div class="card mb-3">
        <h2 class="headline-sm mb-2">Imágenes</h2>

        <InputFile OnChange="AgregarImagenesAsync" accept="image/jpeg,image/png,image/webp" multiple disabled="@_subiendoImagen" />
        @if (_subiendoImagen)
        {
            <p class="body-sm mt-2">Subiendo...</p>
        }

        @if (_imagenes is null)
        {
            <p class="body-md mt-2">Cargando imágenes...</p>
        }
        else if (_imagenes.Count == 0)
        {
            <p class="body-md mt-2 mb-0">Todavía no hay imágenes cargadas.</p>
        }
        else
        {
            <div class="persona-imagenes-galeria mt-3">
                @foreach (var imagen in _imagenes)
                {
                    <div class="persona-imagen-item">
                        <img src="@imagen.UrlDescarga" alt="Imagen de la persona" loading="lazy" />
                        <AuthorizeView Roles="Supervisor,Admin" Context="authContext">
                            <Authorized>
                                <button type="button" class="btn-secondary" @onclick="() => QuitarImagenAsync(imagen.Id)" disabled="@_subiendoImagen">
                                    Eliminar
                                </button>
                            </Authorized>
                        </AuthorizeView>
                    </div>
                }
            </div>
        }
    </div>

    <div class="card mb-3">
        <h2 class="headline-sm mb-2">Vehículos vinculados</h2>
        @if (_vehiculosVinculados is null)
        {
            <p class="body-md">Cargando...</p>
        }
        else if (_vehiculosVinculados.Count == 0)
        {
            <p class="body-md">Ningún vehículo vinculado todavía.</p>
        }
        else
        {
            <ul class="mb-3">
                @foreach (var vehiculo in _vehiculosVinculados)
                {
                    <li class="body-sm">
                        <a href="@($"vehiculos/{vehiculo.Id}")">@vehiculo.Marca @vehiculo.Modelo</a>
                        @if (vehiculo.Dominio is not null)
                        {
                            <span class="mono-data"> — @vehiculo.Dominio</span>
                        }
                    </li>
                }
            </ul>
        }

        <div class="d-flex gap-2">
            <input class="form-control mono-data" @bind="_dominioBuscado" @bind:event="oninput" placeholder="Buscar vehículo por dominio..." disabled="@_vinculandoVehiculo" />
            <button type="button" class="btn-secondary" @onclick="BuscarVehiculosAsync" disabled="@_vinculandoVehiculo">Buscar</button>
        </div>

        @if (_resultadosVehiculos is not null)
        {
            @if (_resultadosVehiculos.Count == 0)
            {
                <p class="body-sm mt-2 mb-0">Sin resultados.</p>
            }
            else
            {
                <ul class="mt-2 mb-0">
                    @foreach (var resultado in _resultadosVehiculos)
                    {
                        <li class="body-sm">
                            @resultado.Marca @resultado.Modelo (@resultado.Dominio)
                            <button type="button" class="btn-secondary" @onclick="() => VincularVehiculoAsync(resultado.Id)" disabled="@_vinculandoVehiculo">Vincular</button>
                        </li>
                    }
                </ul>
            }
        }
    </div>

    <div class="card mt-3">
        <h2 class="headline-sm mb-2">Historial de Informes</h2>
        @if (_historial is null)
        {
            <p class="body-md">Cargando historial...</p>
        }
        else if (_historial.Count == 0)
        {
            <p class="body-md">Esta persona no aparece en ningún Informe todavía.</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th class="label-md">ID Registro</th>
                        <th class="label-md">Fecha de análisis</th>
                        <th class="label-md">Estado</th>
                        <th class="label-md">Evidencias</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _historial)
                    {
                        <tr style="cursor: pointer;" @onclick="@(() => IrAlInforme(item.InformeId))">
                            <td class="body-sm mono-data">@item.IdRegistro</td>
                            <td class="body-sm">@item.FechaAnalisis.ToString("dd/MM/yyyy")</td>
                            <td class="body-sm">
                                @if (item.Estado == EstadoInforme.Publicado)
                                {
                                    <StatusChip Texto="Publicado" Semantica="ChipSemantica.Safe" />
                                }
                                else
                                {
                                    <StatusChip Texto="Borrador" Semantica="ChipSemantica.Warning" />
                                }
                            </td>
                            <td class="body-sm">@item.CantidadEvidencias</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    @if (_errorMessage is not null)
    {
        <div class="status-chip status-chip--alert mt-3">@_errorMessage</div>
    }
}

@code {
    [Parameter]
    public Guid PersonaId { get; set; }

    private PersonaDto? _persona;
    private bool _cargado;
    private IReadOnlyCollection<InformeHistorialDto>? _historial;
    private IReadOnlyCollection<PersonaImagenDto>? _imagenes;
    private IReadOnlyCollection<VehiculoVinculadoResumenDto>? _vehiculosVinculados;
    private IReadOnlyCollection<VehiculoResumenDto>? _resultadosVehiculos;
    private string _dominioBuscado = string.Empty;
    private bool _vinculandoVehiculo;
    private string _nombreIdentificar = string.Empty;
    private string _dniIdentificar = string.Empty;
    private RolPersona _rolSeleccionado;
    private string? _errorMessage;
    private bool _procesando;
    private bool _subiendoImagen;

    private const long TamanioMaximoImagenBytes = 10 * 1024 * 1024;
    private const int CantidadMaximaArchivosPorSeleccion = 20;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
        _historial = await Sender.Send(new ObtenerHistorialInformesPersonaQuery(PersonaId));
        await CargarImagenesAsync();
        await CargarVehiculosVinculadosAsync();
    }

    private async Task CargarVehiculosVinculadosAsync()
    {
        _vehiculosVinculados = await Sender.Send(new ListarVehiculosVinculadosQuery(PersonaId));
    }

    private async Task BuscarVehiculosAsync()
    {
        if (string.IsNullOrWhiteSpace(_dominioBuscado) || _dominioBuscado.Trim().Length < 3)
        {
            _errorMessage = "Ingresá al menos 3 caracteres para buscar.";
            return;
        }

        _errorMessage = null;
        _resultadosVehiculos = await Sender.Send(new BuscarVehiculosQuery(_dominioBuscado));
    }

    private async Task VincularVehiculoAsync(Guid vehiculoId)
    {
        _errorMessage = null;
        _vinculandoVehiculo = true;

        try
        {
            await Sender.Send(new VincularVehiculoACommand(PersonaId, vehiculoId));
            _resultadosVehiculos = null;
            _dominioBuscado = string.Empty;
            await CargarVehiculosVinculadosAsync();
        }
        catch (Exception)
        {
            _errorMessage = "No se pudo vincular el vehículo.";
        }
        finally
        {
            _vinculandoVehiculo = false;
        }
    }

    private async Task CargarImagenesAsync()
    {
        _imagenes = await Sender.Send(new ListarImagenesPersonaQuery(PersonaId));
    }

    private async Task AgregarImagenesAsync(InputFileChangeEventArgs e)
    {
        _errorMessage = null;
        _subiendoImagen = true;

        try
        {
            foreach (var archivo in e.GetMultipleFiles(CantidadMaximaArchivosPorSeleccion))
            {
                using var stream = archivo.OpenReadStream(TamanioMaximoImagenBytes);
                using var memoria = new MemoryStream();
                await stream.CopyToAsync(memoria);

                await Sender.Send(new AgregarImagenPersonaCommand(PersonaId, memoria.ToArray(), archivo.Name, archivo.ContentType));
            }

            await CargarImagenesAsync();
        }
        catch (Exception)
        {
            _errorMessage = "No se pudo subir una o más imágenes. Verificá el formato (JPEG/PNG/WebP) y el tamaño (máx. 10MB).";
        }
        finally
        {
            _subiendoImagen = false;
        }
    }

    private async Task QuitarImagenAsync(Guid personaImagenId)
    {
        _errorMessage = null;
        _subiendoImagen = true;

        try
        {
            await Sender.Send(new QuitarImagenPersonaCommand(personaImagenId));
            await CargarImagenesAsync();
        }
        catch (Exception)
        {
            _errorMessage = "No se pudo eliminar la imagen.";
        }
        finally
        {
            _subiendoImagen = false;
        }
    }

    private async Task CargarAsync()
    {
        _persona = await Sender.Send(new ObtenerPersonaPorIdQuery(PersonaId));
        _cargado = true;

        if (_persona is not null)
        {
            _rolSeleccionado = _persona.Rol;
        }
    }

    private void IrAlInforme(Guid informeId) => NavigationManager.NavigateTo($"informes/{informeId}");

    private async Task IdentificarAsync()
    {
        if (string.IsNullOrWhiteSpace(_nombreIdentificar))
        {
            _errorMessage = "El nombre es obligatorio para identificar a la persona.";
            return;
        }

        _errorMessage = null;
        _procesando = true;

        try
        {
            await Sender.Send(new IdentificarPersonaCommand(
                PersonaId,
                _nombreIdentificar,
                string.IsNullOrWhiteSpace(_dniIdentificar) ? null : _dniIdentificar));

            await CargarAsync();
        }
        catch (Exception)
        {
            _errorMessage = "No se pudo identificar a la persona.";
        }
        finally
        {
            _procesando = false;
        }
    }

    private async Task CambiarRolAsync()
    {
        _errorMessage = null;
        _procesando = true;

        try
        {
            await Sender.Send(new CambiarRolPersonaCommand(PersonaId, _rolSeleccionado));
            await CargarAsync();
        }
        catch (Exception)
        {
            _errorMessage = "No se pudo cambiar el rol de la persona.";
        }
        finally
        {
            _procesando = false;
        }
    }
}
