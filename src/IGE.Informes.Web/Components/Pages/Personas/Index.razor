@page "/personas"
@attribute [Authorize]
@using IGE.Informes.Application.Common.Dtos
@using IGE.Informes.Application.Personas.Queries.ListarPersonas
@using MediatR
@inject ISender Sender

<PageTitle>Personas · IGE 4.0</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="headline-md">Personas</h1>
    <a class="btn-primary" href="personas/nueva">Nueva Persona</a>
</div>

@if (_personas is null)
{
    <p class="body-md">Cargando...</p>
}
else if (_personas.Count == 0)
{
    <div class="card">
        <p class="body-md mb-0">Todavía no hay personas cargadas.</p>
    </div>
}
else
{
    <div class="card p-0">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th class="label-md">Nombre</th>
                    <th class="label-md">Rol</th>
                    <th class="label-md">Estado</th>
                    <th class="label-md"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var persona in _personas)
                {
                    <tr>
                        <td class="body-md">@(persona.Nombre ?? "Sin identificar")</td>
                        <td class="body-md">@persona.Rol</td>
                        <td>
                            @if (persona.Identificada)
                            {
                                <StatusChip Texto="Identificada" Semantica="ChipSemantica.Safe" />
                            }
                            else
                            {
                                <StatusChip Texto="Sin identificar" Semantica="ChipSemantica.Neutral" />
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn-secondary" href="@($"personas/{persona.Id}")">Ver</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <Paginador Pagina="_pagina" TotalPaginas="_resultado!.TotalPaginas" TotalItems="_resultado.TotalItems" PaginaCambiada="CambiarPaginaAsync" />
}

@code {
    private PagedResult<PersonaResumenDto>? _resultado;
    private IReadOnlyCollection<PersonaResumenDto>? _personas;
    private int _pagina = 1;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _resultado = await Sender.Send(new ListarPersonasQuery(_pagina));
        _personas = _resultado.Items;
    }

    private async Task CambiarPaginaAsync(int nuevaPagina)
    {
        _pagina = nuevaPagina;
        _personas = null;
        await CargarAsync();
    }
}
