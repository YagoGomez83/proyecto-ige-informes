@page "/vehiculos"
@attribute [Authorize]
@using IGE.Informes.Application.Common.Dtos
@using IGE.Informes.Application.Vehiculos.Queries.ListarVehiculos
@using IGE.Informes.Domain.Entities
@using MediatR
@inject ISender Sender

<PageTitle>Vehículos · IGE 4.0</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="headline-md">Vehículos</h1>
    <a class="btn-primary" href="vehiculos/nuevo">Nuevo Vehículo</a>
</div>

@if (_vehiculos is null)
{
    <p class="body-md">Cargando...</p>
}
else if (_vehiculos.Count == 0)
{
    <div class="card">
        <p class="body-md mb-0">Todavía no hay vehículos cargados.</p>
    </div>
}
else
{
    <div class="card p-0">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th class="label-md">Marca / Modelo</th>
                    <th class="label-md">Dominio</th>
                    <th class="label-md">Estado</th>
                    <th class="label-md">Acción a realizar</th>
                    <th class="label-md"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var vehiculo in _vehiculos)
                {
                    var estadoChip = VehiculoChips.Para(vehiculo.Estado);

                    <tr>
                        <td class="body-md">@vehiculo.Marca @vehiculo.Modelo</td>
                        <td class="mono-data">@(vehiculo.Dominio ?? "—")</td>
                        <td><StatusChip Texto="@estadoChip.Texto" Semantica="estadoChip.Semantica" /></td>
                        <td class="body-md">@(vehiculo.AccionARealizar == AccionARealizar.Detener ? "Detener" : "Identificar")</td>
                        <td class="text-end">
                            <a class="btn-secondary" href="@($"vehiculos/{vehiculo.Id}")">Ver</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <Paginador Pagina="_pagina" TotalPaginas="_resultado!.TotalPaginas" TotalItems="_resultado.TotalItems" PaginaCambiada="CambiarPaginaAsync" />
}

@code {
    private PagedResult<VehiculoResumenDto>? _resultado;
    private IReadOnlyCollection<VehiculoResumenDto>? _vehiculos;
    private int _pagina = 1;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _resultado = await Sender.Send(new ListarVehiculosQuery(_pagina));
        _vehiculos = _resultado.Items;
    }

    private async Task CambiarPaginaAsync(int nuevaPagina)
    {
        _pagina = nuevaPagina;
        _vehiculos = null;
        await CargarAsync();
    }
}
