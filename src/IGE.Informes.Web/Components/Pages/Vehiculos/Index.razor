@page "/vehiculos"
@attribute [Authorize]
@using IGE.Informes.Application.Common.Dtos
@using IGE.Informes.Application.Vehiculos.Queries.ListarVehiculos
@using IGE.Informes.Domain.Entities
@using MediatR
@inject ISender Sender

<PageTitle>Vehículos · IGE 4.0</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="headline-md">Vehículos</h1>
    <a class="btn-primary" href="vehiculos/nuevo">Nuevo Vehículo</a>
</div>

<div class="d-flex gap-3 mb-3">
    <div>
        <label class="label-md" for="filtroEstado">Estado</label>
        <select id="filtroEstado" class="form-control" @bind="_filtroEstado" @bind:after="AplicarFiltrosAsync">
            <option value="">Todos</option>
            <option value="Vigente">Vigente</option>
            <option value="Identificado">Identificado</option>
        </select>
    </div>
    <div>
        <label class="label-md" for="ordenVehiculos">Ordenar por</label>
        <select id="ordenVehiculos" class="form-control" @bind="_orden" @bind:after="AplicarFiltrosAsync">
            <option value="@OrdenVehiculos.Estado">Estado</option>
            <option value="@OrdenVehiculos.Alfabetico">Alfabético</option>
        </select>
    </div>
</div>

@if (_vehiculos is null)
{
    <p class="body-md">Cargando...</p>
}
else if (_vehiculos.Count == 0)
{
    <div class="card">
        <p class="body-md mb-0">Todavía no hay vehículos cargados.</p>
    </div>
}
else
{
    <div class="card p-0">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th class="label-md">Marca / Modelo</th>
                    <th class="label-md">Dominio</th>
                    <th class="label-md">Estado</th>
                    <th class="label-md">Acción a realizar</th>
                    <th class="label-md"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var vehiculo in _vehiculos)
                {
                    var estadoChip = VehiculoChips.Para(vehiculo.Estado);

                    <tr>
                        <td class="body-md">@vehiculo.Marca @vehiculo.Modelo</td>
                        <td class="mono-data">@(vehiculo.Dominio ?? "—")</td>
                        <td><StatusChip Texto="@estadoChip.Texto" Semantica="estadoChip.Semantica" /></td>
                        <td class="body-md">
                            @(vehiculo.AccionARealizar switch
                            {
                                AccionARealizar.Detener => "Detener",
                                AccionARealizar.Identificar => "Identificar",
                                AccionARealizar.SinAccion => "Sin acción",
                                _ => vehiculo.AccionARealizar.ToString(),
                            })
                        </td>
                        <td class="text-end">
                            <a class="btn-secondary" href="@($"vehiculos/{vehiculo.Id}")">Ver</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <Paginador Pagina="_pagina" TotalPaginas="_resultado!.TotalPaginas" TotalItems="_resultado.TotalItems" PaginaCambiada="CambiarPaginaAsync" />
}

@code {
    private PagedResult<VehiculoResumenDto>? _resultado;
    private IReadOnlyCollection<VehiculoResumenDto>? _vehiculos;
    private int _pagina = 1;
    private string _filtroEstado = string.Empty;
    private OrdenVehiculos _orden = OrdenVehiculos.Estado;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        EstadoVehiculo? estado = string.IsNullOrEmpty(_filtroEstado)
            ? null
            : Enum.Parse<EstadoVehiculo>(_filtroEstado);

        _resultado = await Sender.Send(new ListarVehiculosQuery(_pagina, Estado: estado, Orden: _orden));
        _vehiculos = _resultado.Items;
    }

    private async Task CambiarPaginaAsync(int nuevaPagina)
    {
        _pagina = nuevaPagina;
        _vehiculos = null;
        await CargarAsync();
    }

    private async Task AplicarFiltrosAsync()
    {
        _pagina = 1;
        _vehiculos = null;
        await CargarAsync();
    }
}
