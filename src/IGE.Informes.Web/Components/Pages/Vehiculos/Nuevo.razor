@page "/vehiculos/nuevo"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using FluentValidation
@using IGE.Informes.Application.CategoriasAlerta.Queries.ListarCategoriasAlerta
@using IGE.Informes.Application.ColorVehiculo.Commands.CrearColorVehiculo
@using IGE.Informes.Application.ColorVehiculo.Queries.ListarColorVehiculo
@using IGE.Informes.Application.MarcaVehiculo.Commands.CrearMarcaVehiculo
@using IGE.Informes.Application.MarcaVehiculo.Queries.ListarMarcaVehiculo
@using IGE.Informes.Application.Vehiculos.Commands.RegistrarVehiculo
@using IGE.Informes.Domain.Entities
@using MediatR
@inject ISender Sender
@inject NavigationManager NavigationManager

<PageTitle>Nuevo Vehículo · IGE 4.0</PageTitle>

<h1 class="headline-md mb-3">Nuevo Vehículo</h1>

<div class="card card-form-md">
    <EditForm Model="_input" OnValidSubmit="RegistrarAsync" FormName="nuevo-vehiculo">
        <DataAnnotationsValidator />

        @if (_errorMessage is not null)
        {
            <div class="status-chip status-chip--alert mb-3">@_errorMessage</div>
        }

        <div class="mb-3">
            <label class="label-md" for="marca">Marca</label>
            <select id="marca" class="form-control" @bind="_marcaSeleccionada">
                <option value="">Seleccionar...</option>
                @if (_marcas is not null)
                {
                    @foreach (var marca in _marcas)
                    {
                        <option value="@marca.Nombre">@marca.Nombre</option>
                    }
                }
                <option value="@OtraOpcion">Otra (especificar)</option>
            </select>

            @if (_marcaSeleccionada == OtraOpcion)
            {
                <input class="form-control mt-2" placeholder="Marca no listada" @bind="_input.Marca" @bind:event="oninput" />
            }

            <AuthorizeView Roles="Admin" Context="authContext">
                <Authorized>
                    @if (!_mostrandoNuevaMarca)
                    {
                        <button type="button" class="btn-secondary mt-2" @onclick="() => _mostrandoNuevaMarca = true">
                            + Nueva Marca
                        </button>
                    }
                    else
                    {
                        <div class="card mt-2 p-3">
                            @if (_errorNuevaMarca is not null)
                            {
                                <div class="status-chip status-chip--alert mb-2">@_errorNuevaMarca</div>
                            }
                            <div class="mb-2">
                                <label class="label-md" for="nuevaMarcaNombre">Nombre</label>
                                <input id="nuevaMarcaNombre" class="form-control" placeholder="Ej: Hyundai" @bind="_nuevaMarcaNombre" />
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn-primary" @onclick="CrearMarcaAsync" disabled="@_creandoMarca">Guardar Marca</button>
                                <button type="button" class="btn-secondary" @onclick="CancelarNuevaMarca">Cancelar</button>
                            </div>
                        </div>
                    }
                </Authorized>
            </AuthorizeView>
        </div>

        <div class="mb-3">
            <label class="label-md" for="modelo">Modelo</label>
            <InputText id="modelo" class="form-control" @bind-Value="_input.Modelo" />
        </div>

        <div class="mb-3">
            <label class="label-md" for="color">Color</label>
            <select id="color" class="form-control" @bind="_colorSeleccionado">
                <option value="">Seleccionar...</option>
                @if (_colores is not null)
                {
                    @foreach (var color in _colores)
                    {
                        <option value="@color.Nombre">@color.Nombre</option>
                    }
                }
                <option value="@OtraOpcion">Otra (especificar)</option>
            </select>

            @if (_colorSeleccionado == OtraOpcion)
            {
                <input class="form-control mt-2" placeholder="Color no listado" @bind="_input.Color" @bind:event="oninput" />
            }

            <AuthorizeView Roles="Admin" Context="authContext">
                <Authorized>
                    @if (!_mostrandoNuevoColor)
                    {
                        <button type="button" class="btn-secondary mt-2" @onclick="() => _mostrandoNuevoColor = true">
                            + Nuevo Color
                        </button>
                    }
                    else
                    {
                        <div class="card mt-2 p-3">
                            @if (_errorNuevoColor is not null)
                            {
                                <div class="status-chip status-chip--alert mb-2">@_errorNuevoColor</div>
                            }
                            <div class="mb-2">
                                <label class="label-md" for="nuevoColorNombre">Nombre</label>
                                <input id="nuevoColorNombre" class="form-control" placeholder="Ej: Gris Plata" @bind="_nuevoColorNombre" />
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn-primary" @onclick="CrearColorAsync" disabled="@_creandoColor">Guardar Color</button>
                                <button type="button" class="btn-secondary" @onclick="CancelarNuevoColor">Cancelar</button>
                            </div>
                        </div>
                    }
                </Authorized>
            </AuthorizeView>
        </div>

        <div class="mb-3">
            <label class="label-md" for="dominio">Dominio (opcional, formato libre)</label>
            <InputText id="dominio" class="form-control mono-data" @bind-Value="_input.Dominio" />
        </div>

        <div class="mb-3">
            <label class="label-md" for="dominioCerteza">Certeza del dominio</label>
            <InputSelect id="dominioCerteza" class="form-control" @bind-Value="_input.DominioCerteza">
                <option value="@CertezaDominio.Confirmado">Confirmado</option>
                <option value="@CertezaDominio.Parcial">Parcial</option>
                <option value="@CertezaDominio.Incierto">Incierto</option>
            </InputSelect>
        </div>

        <div class="mb-3">
            <label class="label-md" for="accionARealizar">Acción a realizar</label>
            <InputSelect id="accionARealizar" class="form-control" @bind-Value="_input.AccionARealizar">
                <option value="@AccionARealizar.Detener">Detener</option>
                <option value="@AccionARealizar.Identificar">Identificar</option>
                <option value="@AccionARealizar.SinAccion">Sin acción (solo referencia)</option>
            </InputSelect>
        </div>

        <div class="mb-3">
            <label class="label-md" for="avisarA">Avisar a</label>
            <InputText id="avisarA" class="form-control" @bind-Value="_input.AvisarA" />
        </div>

        <div class="mb-3">
            <label class="label-md">Categorías de alerta</label>
            @if (_categoriasAlerta is not null)
            {
                @foreach (var categoria in _categoriasAlerta)
                {
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="@($"categoria-{categoria.Id}")"
                               checked="@_input.CategoriasAlertaIds.Contains(categoria.Id)"
                               @onchange="@(e => AlternarCategoria(categoria.Id, (bool)e.Value!))" />
                        <label class="form-check-label body-sm" for="@($"categoria-{categoria.Id}")">@categoria.Nombre</label>
                    </div>
                }
            }
        </div>

        <div class="mb-3">
            <label class="label-md" for="caracteristicas">Características (opcional)</label>
            <InputTextArea id="caracteristicas" class="form-control" rows="3" @bind-Value="_input.Caracteristicas" />
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn-primary" disabled="@_guardando">Guardar Vehículo</button>
            <a class="btn-secondary" href="vehiculos">Cancelar</a>
        </div>
    </EditForm>
</div>

@code {
    private const string OtraOpcion = "__otra__";

    private readonly InputModel _input = new();
    private IReadOnlyCollection<CategoriaAlertaDto>? _categoriasAlerta;
    private string? _errorMessage;
    private bool _guardando;

    private IReadOnlyCollection<MarcaVehiculoDto>? _marcas;
    private string _marcaSeleccionada = string.Empty;
    private bool _mostrandoNuevaMarca;
    private string _nuevaMarcaNombre = string.Empty;
    private bool _creandoMarca;
    private string? _errorNuevaMarca;

    private IReadOnlyCollection<ColorVehiculoDto>? _colores;
    private string _colorSeleccionado = string.Empty;
    private bool _mostrandoNuevoColor;
    private string _nuevoColorNombre = string.Empty;
    private bool _creandoColor;
    private string? _errorNuevoColor;

    protected override async Task OnInitializedAsync()
    {
        _categoriasAlerta = await Sender.Send(new ListarCategoriasAlertaQuery());
        _marcas = await Sender.Send(new ListarMarcaVehiculoQuery());
        _colores = await Sender.Send(new ListarColorVehiculoQuery());
    }

    private void AlternarCategoria(Guid categoriaId, bool marcada)
    {
        if (marcada)
        {
            _input.CategoriasAlertaIds.Add(categoriaId);
        }
        else
        {
            _input.CategoriasAlertaIds.Remove(categoriaId);
        }
    }

    private void CancelarNuevaMarca()
    {
        _mostrandoNuevaMarca = false;
        _nuevaMarcaNombre = string.Empty;
        _errorNuevaMarca = null;
    }

    private async Task CrearMarcaAsync()
    {
        if (string.IsNullOrWhiteSpace(_nuevaMarcaNombre))
        {
            _errorNuevaMarca = "El nombre es obligatorio.";
            return;
        }

        _errorNuevaMarca = null;
        _creandoMarca = true;

        try
        {
            await Sender.Send(new CrearMarcaVehiculoCommand(_nuevaMarcaNombre));

            _marcas = await Sender.Send(new ListarMarcaVehiculoQuery());
            _marcaSeleccionada = _nuevaMarcaNombre;
            _input.Marca = _nuevaMarcaNombre;

            CancelarNuevaMarca();
        }
        catch (FluentValidation.ValidationException ex)
        {
            _errorNuevaMarca = string.Join(" ", ex.Errors.Select(e => e.ErrorMessage));
        }
        catch (Exception)
        {
            _errorNuevaMarca = "No se pudo crear la Marca. Verificá que el nombre no esté repetido.";
        }
        finally
        {
            _creandoMarca = false;
        }
    }

    private void CancelarNuevoColor()
    {
        _mostrandoNuevoColor = false;
        _nuevoColorNombre = string.Empty;
        _errorNuevoColor = null;
    }

    private async Task CrearColorAsync()
    {
        if (string.IsNullOrWhiteSpace(_nuevoColorNombre))
        {
            _errorNuevoColor = "El nombre es obligatorio.";
            return;
        }

        _errorNuevoColor = null;
        _creandoColor = true;

        try
        {
            await Sender.Send(new CrearColorVehiculoCommand(_nuevoColorNombre));

            _colores = await Sender.Send(new ListarColorVehiculoQuery());
            _colorSeleccionado = _nuevoColorNombre;
            _input.Color = _nuevoColorNombre;

            CancelarNuevoColor();
        }
        catch (FluentValidation.ValidationException ex)
        {
            _errorNuevoColor = string.Join(" ", ex.Errors.Select(e => e.ErrorMessage));
        }
        catch (Exception)
        {
            _errorNuevoColor = "No se pudo crear el Color. Verificá que el nombre no esté repetido.";
        }
        finally
        {
            _creandoColor = false;
        }
    }

    private async Task RegistrarAsync()
    {
        _errorMessage = null;

        var marcaFinal = _marcaSeleccionada == OtraOpcion ? _input.Marca : _marcaSeleccionada;
        var colorFinal = _colorSeleccionado == OtraOpcion ? _input.Color : _colorSeleccionado;

        if (string.IsNullOrWhiteSpace(marcaFinal))
        {
            _errorMessage = "Seleccioná una Marca del catálogo o elegí \"Otra\" y especificá cuál.";
            return;
        }

        if (string.IsNullOrWhiteSpace(colorFinal))
        {
            _errorMessage = "Seleccioná un Color del catálogo o elegí \"Otra\" y especificá cuál.";
            return;
        }

        _guardando = true;

        try
        {
            var vehiculoId = await Sender.Send(new RegistrarVehiculoCommand(
                marcaFinal,
                _input.Modelo,
                colorFinal,
                _input.DominioCerteza,
                _input.AccionARealizar,
                _input.AvisarA,
                string.IsNullOrWhiteSpace(_input.Dominio) ? null : _input.Dominio,
                string.IsNullOrWhiteSpace(_input.Caracteristicas) ? null : _input.Caracteristicas,
                _input.CategoriasAlertaIds));

            NavigationManager.NavigateTo($"vehiculos/{vehiculoId}");
        }
        catch (FluentValidation.ValidationException ex)
        {
            _errorMessage = string.Join(" ", ex.Errors.Select(e => e.ErrorMessage));
        }
        catch (Exception)
        {
            _errorMessage = "No se pudo registrar el vehículo. Verificá los datos e intentá de nuevo.";
        }
        finally
        {
            _guardando = false;
        }
    }

    private sealed class InputModel
    {
        public string Marca { get; set; } = string.Empty;

        [Required(ErrorMessage = "El modelo es obligatorio.")]
        public string Modelo { get; set; } = string.Empty;

        public string Color { get; set; } = string.Empty;

        public string? Dominio { get; set; }

        public CertezaDominio DominioCerteza { get; set; } = CertezaDominio.Incierto;

        public AccionARealizar AccionARealizar { get; set; } = AccionARealizar.Detener;

        [Required(ErrorMessage = "El dato de a quién avisar es obligatorio.")]
        public string AvisarA { get; set; } = string.Empty;

        public string? Caracteristicas { get; set; }

        public List<Guid> CategoriasAlertaIds { get; } = [];
    }
}
