@page "/vehiculos/{VehiculoId:guid}"
@attribute [Authorize]
@using IGE.Informes.Application.CategoriasAlerta.Queries.ListarCategoriasAlerta
@using IGE.Informes.Application.Common.Dtos
@using IGE.Informes.Application.Vehiculos.Commands.AgregarImagenVehiculo
@using IGE.Informes.Application.Vehiculos.Commands.AsignarCategoriaAlerta
@using IGE.Informes.Application.Vehiculos.Commands.CambiarEstadoVehiculo
@using IGE.Informes.Application.Vehiculos.Commands.DarDeBajaVehiculo
@using IGE.Informes.Application.Personas.Queries.BuscarPersonas
@using IGE.Informes.Application.Vehiculos.Commands.QuitarImagenVehiculo
@using IGE.Informes.Application.Personas.Commands.VincularVehiculo
@using IGE.Informes.Application.Vehiculos.Queries.ListarImagenesVehiculo
@using IGE.Informes.Application.Vehiculos.Queries.ListarPersonasVinculadas
@using IGE.Informes.Application.Vehiculos.Queries.ObtenerHistorialInformesVehiculo
@using IGE.Informes.Application.Vehiculos.Queries.ObtenerVehiculoPorId
@using IGE.Informes.Domain.Entities
@using Microsoft.AspNetCore.Components.Forms
@using MediatR
@inject ISender Sender
@inject NavigationManager NavigationManager

<PageTitle>Detalle de Vehículo · IGE 4.0</PageTitle>

@if (!_cargado)
{
    <p class="body-md">Cargando...</p>
}
else if (_vehiculo is null)
{
    <p class="body-md">No se encontró el vehículo solicitado.</p>
}
else
{
    var estadoChip = VehiculoChips.Para(_vehiculo.Estado);

    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h1 class="headline-md mb-1">@_vehiculo.Marca @_vehiculo.Modelo</h1>
            <StatusChip Texto="@estadoChip.Texto" Semantica="estadoChip.Semantica" />
        </div>
        <a class="btn-secondary" href="vehiculos">Volver al listado</a>
    </div>

    <div class="card mb-3">
        <h2 class="headline-sm mb-2">Datos generales</h2>
        <dl class="row mb-0">
            <dt class="col-sm-3 label-md">Dominio</dt>
            <dd class="col-sm-9 mono-data">@(_vehiculo.Dominio ?? "—") (@_vehiculo.DominioCerteza)</dd>

            <dt class="col-sm-3 label-md">Color</dt>
            <dd class="col-sm-9 body-md">@_vehiculo.Color</dd>

            <dt class="col-sm-3 label-md">Acción a realizar</dt>
            <dd class="col-sm-9 body-md">
                @(_vehiculo.AccionARealizar switch
                {
                    AccionARealizar.Detener => "Detener",
                    AccionARealizar.Identificar => "Identificar",
                    AccionARealizar.SinAccion => "Sin acción (solo referencia)",
                    _ => _vehiculo.AccionARealizar.ToString(),
                })
            </dd>

            <dt class="col-sm-3 label-md">Avisar a</dt>
            <dd class="col-sm-9 body-md">@_vehiculo.AvisarA</dd>

            <dt class="col-sm-3 label-md">Características</dt>
            <dd class="col-sm-9 body-md">@(_vehiculo.Caracteristicas ?? "—")</dd>

            <dt class="col-sm-3 label-md">Fecha de baja</dt>
            <dd class="col-sm-9 body-md">@(_vehiculo.FechaBaja?.ToString("dd/MM/yyyy") ?? "—")</dd>

            <dt class="col-sm-3 label-md">Categorías de alerta</dt>
            <dd class="col-sm-9 body-md">
                @if (_vehiculo.CategoriasAlertaIds.Count == 0)
                {
                    <span>—</span>
                }
                else
                {
                    @string.Join(", ", _vehiculo.CategoriasAlertaIds
                        .Select(id => _categoriasAlerta?.FirstOrDefault(c => c.Id == id)?.Nombre ?? "—"))
                }
            </dd>
        </dl>
    </div>

    <div class="card mb-3">
        <h2 class="headline-sm mb-2">Cambiar estado</h2>
        <div class="d-flex gap-2">
            <button type="button" class="btn-primary" @onclick="MarcarIdentificadoAsync"
                    disabled="@(_procesando || _vehiculo.Estado == EstadoVehiculo.Identificado)">
                Marcar Identificado
            </button>
            <button type="button" class="btn-secondary" @onclick="MarcarVigenteAsync"
                    disabled="@(_procesando || _vehiculo.Estado == EstadoVehiculo.Vigente)">
                Marcar Vigente
            </button>
        </div>
    </div>

    <div class="card mb-3">
        <h2 class="headline-sm mb-2">Asignar categoría de alerta</h2>
        <div class="d-flex align-items-end gap-2">
            <div class="flex-grow-1">
                <select class="form-control" @bind="_categoriaSeleccionadaId">
                    <option value="">Seleccionar...</option>
                    @if (_categoriasAlerta is not null)
                    {
                        @foreach (var categoria in _categoriasAlerta)
                        {
                            <option value="@categoria.Id">@categoria.Nombre</option>
                        }
                    }
                </select>
            </div>
            <button type="button" class="btn-secondary" @onclick="AsignarCategoriaAsync" disabled="@_procesando">Asignar</button>
        </div>
    </div>

    <div class="card">
        <h2 class="headline-sm mb-2">Dar de baja (fin de vigilancia activa)</h2>
        <div class="d-flex align-items-end gap-2">
            <div>
                <label class="label-md" for="fechaBaja">Fecha de baja</label>
                <input id="fechaBaja" type="date" class="form-control" @bind="_fechaBaja" />
            </div>
            <button type="button" class="btn-secondary" @onclick="DarDeBajaAsync" disabled="@_procesando">Confirmar baja</button>
        </div>
    </div>

    <div class="card mb-3">
        <h2 class="headline-sm mb-2">Imágenes</h2>

        <InputFile class="form-control" OnChange="AgregarImagenesAsync" accept="image/jpeg,image/png,image/webp" multiple disabled="@_subiendoImagen" />
        @if (_subiendoImagen)
        {
            <p class="body-sm mt-2">Subiendo...</p>
        }

        @if (_imagenes is null)
        {
            <p class="body-md mt-2">Cargando imágenes...</p>
        }
        else if (_imagenes.Count == 0)
        {
            <p class="body-md mt-2 mb-0">Todavía no hay imágenes cargadas.</p>
        }
        else
        {
            <div class="vehiculo-imagenes-galeria mt-3">
                @foreach (var imagen in _imagenes)
                {
                    <div class="vehiculo-imagen-item">
                        <img src="@imagen.UrlDescarga" alt="Imagen del vehículo" loading="lazy" />
                        <AuthorizeView Roles="Supervisor,Admin" Context="authContext">
                            <Authorized>
                                <button type="button" class="btn-secondary" @onclick="() => QuitarImagenAsync(imagen.Id)" disabled="@_subiendoImagen">
                                    Eliminar
                                </button>
                            </Authorized>
                        </AuthorizeView>
                    </div>
                }
            </div>
        }
    </div>

    <div class="card mb-3">
        <h2 class="headline-sm mb-2">Personas vinculadas</h2>
        @if (_personasVinculadas is null)
        {
            <p class="body-md">Cargando...</p>
        }
        else if (_personasVinculadas.Count == 0)
        {
            <p class="body-md">Ninguna persona vinculada todavía.</p>
        }
        else
        {
            <ul class="mb-3">
                @foreach (var persona in _personasVinculadas)
                {
                    <li class="body-sm">
                        <a href="@($"personas/{persona.Id}")">@(persona.Nombre ?? "Sin identificar")</a>
                        @if (persona.Dni is not null)
                        {
                            <span class="mono-data"> — @persona.Dni</span>
                        }
                    </li>
                }
            </ul>
        }

        <div class="d-flex gap-2">
            <input class="form-control" @bind="_dniOnombreBuscado" @bind:event="oninput" placeholder="Buscar persona por DNI o nombre..." disabled="@_vinculandoPersona" />
            <button type="button" class="btn-secondary" @onclick="BuscarPersonasAsync" disabled="@_vinculandoPersona">Buscar</button>
        </div>

        @if (_resultadosPersonas is not null)
        {
            @if (_resultadosPersonas.Count == 0)
            {
                <p class="body-sm mt-2 mb-0">Sin resultados.</p>
            }
            else
            {
                <ul class="mt-2 mb-0">
                    @foreach (var resultado in _resultadosPersonas)
                    {
                        <li class="body-sm">
                            @(resultado.Nombre ?? "Sin identificar") (@(resultado.Dni ?? "sin DNI"))
                            <button type="button" class="btn-secondary" @onclick="() => VincularPersonaAsync(resultado.Id)" disabled="@_vinculandoPersona">Vincular</button>
                        </li>
                    }
                </ul>
            }
        }
    </div>

    <div class="card mt-3">
        <h2 class="headline-sm mb-2">Historial de Informes</h2>
        @if (_historial is null)
        {
            <p class="body-md">Cargando historial...</p>
        }
        else if (_historial.Count == 0)
        {
            <p class="body-md">Este vehículo no aparece en ningún Informe todavía.</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th class="label-md">ID Registro</th>
                        <th class="label-md">Fecha de análisis</th>
                        <th class="label-md">Estado</th>
                        <th class="label-md">Evidencias</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _historial)
                    {
                        <tr class="row-clickable" @onclick="@(() => IrAlInforme(item.InformeId))">
                            <td class="body-sm mono-data">@item.IdRegistro</td>
                            <td class="body-sm">@item.FechaAnalisis.ToString("dd/MM/yyyy")</td>
                            <td class="body-sm">
                                @if (item.Estado == EstadoInforme.Publicado)
                                {
                                    <StatusChip Texto="Publicado" Semantica="ChipSemantica.Safe" />
                                }
                                else
                                {
                                    <StatusChip Texto="Borrador" Semantica="ChipSemantica.Warning" />
                                }
                            </td>
                            <td class="body-sm">@item.CantidadEvidencias</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    @if (_errorMessage is not null)
    {
        <div class="status-chip status-chip--alert mt-3">@_errorMessage</div>
    }
}

@code {
    [Parameter]
    public Guid VehiculoId { get; set; }

    private VehiculoDto? _vehiculo;
    private bool _cargado;
    private IReadOnlyCollection<CategoriaAlertaDto>? _categoriasAlerta;
    private IReadOnlyCollection<InformeHistorialDto>? _historial;
    private IReadOnlyCollection<VehiculoImagenDto>? _imagenes;
    private IReadOnlyCollection<PersonaVinculadaResumenDto>? _personasVinculadas;
    private IReadOnlyCollection<PersonaBusquedaResultDto>? _resultadosPersonas;
    private string _dniOnombreBuscado = string.Empty;
    private bool _vinculandoPersona;
    private string? _categoriaSeleccionadaId;
    private DateTime _fechaBaja = DateTime.Today;
    private string? _errorMessage;
    private bool _procesando;
    private bool _subiendoImagen;

    private const long TamanioMaximoImagenBytes = 10 * 1024 * 1024;
    private const int CantidadMaximaArchivosPorSeleccion = 20;

    protected override async Task OnInitializedAsync()
    {
        _categoriasAlerta = await Sender.Send(new ListarCategoriasAlertaQuery());
        await CargarAsync();
        _historial = await Sender.Send(new ObtenerHistorialInformesVehiculoQuery(VehiculoId));
        await CargarImagenesAsync();
        await CargarPersonasVinculadasAsync();
    }

    private async Task CargarPersonasVinculadasAsync()
    {
        _personasVinculadas = await Sender.Send(new ListarPersonasVinculadasQuery(VehiculoId));
    }

    private async Task BuscarPersonasAsync()
    {
        if (string.IsNullOrWhiteSpace(_dniOnombreBuscado) || _dniOnombreBuscado.Trim().Length < 3)
        {
            _errorMessage = "Ingresá al menos 3 caracteres para buscar.";
            return;
        }

        _errorMessage = null;
        _resultadosPersonas = await Sender.Send(new BuscarPersonasQuery(_dniOnombreBuscado));
    }

    private async Task VincularPersonaAsync(Guid personaId)
    {
        _errorMessage = null;
        _vinculandoPersona = true;

        try
        {
            await Sender.Send(new VincularVehiculoACommand(personaId, VehiculoId));
            _resultadosPersonas = null;
            _dniOnombreBuscado = string.Empty;
            await CargarPersonasVinculadasAsync();
        }
        catch (Exception)
        {
            _errorMessage = "No se pudo vincular la persona.";
        }
        finally
        {
            _vinculandoPersona = false;
        }
    }

    private async Task CargarImagenesAsync()
    {
        _imagenes = await Sender.Send(new ListarImagenesVehiculoQuery(VehiculoId));
    }

    private async Task AgregarImagenesAsync(InputFileChangeEventArgs e)
    {
        _errorMessage = null;
        _subiendoImagen = true;

        try
        {
            foreach (var archivo in e.GetMultipleFiles(CantidadMaximaArchivosPorSeleccion))
            {
                using var stream = archivo.OpenReadStream(TamanioMaximoImagenBytes);
                using var memoria = new MemoryStream();
                await stream.CopyToAsync(memoria);

                await Sender.Send(new AgregarImagenVehiculoCommand(VehiculoId, memoria.ToArray(), archivo.Name, archivo.ContentType));
            }

            await CargarImagenesAsync();
        }
        catch (Exception)
        {
            _errorMessage = "No se pudo subir una o más imágenes. Verificá el formato (JPEG/PNG/WebP) y el tamaño (máx. 10MB).";
        }
        finally
        {
            _subiendoImagen = false;
        }
    }

    private async Task QuitarImagenAsync(Guid vehiculoImagenId)
    {
        _errorMessage = null;
        _subiendoImagen = true;

        try
        {
            await Sender.Send(new QuitarImagenVehiculoCommand(vehiculoImagenId));
            await CargarImagenesAsync();
        }
        catch (Exception)
        {
            _errorMessage = "No se pudo eliminar la imagen.";
        }
        finally
        {
            _subiendoImagen = false;
        }
    }

    private async Task CargarAsync()
    {
        _vehiculo = await Sender.Send(new ObtenerVehiculoPorIdQuery(VehiculoId));
        _cargado = true;
    }

    private void IrAlInforme(Guid informeId) => NavigationManager.NavigateTo($"informes/{informeId}");

    private async Task MarcarIdentificadoAsync() => await CambiarEstadoAsync(EstadoVehiculo.Identificado);

    private async Task MarcarVigenteAsync() => await CambiarEstadoAsync(EstadoVehiculo.Vigente);

    private async Task CambiarEstadoAsync(EstadoVehiculo nuevoEstado)
    {
        _errorMessage = null;
        _procesando = true;

        try
        {
            await Sender.Send(new CambiarEstadoVehiculoCommand(VehiculoId, nuevoEstado));
            await CargarAsync();
        }
        catch (Exception)
        {
            _errorMessage = "No se pudo cambiar el estado del vehículo.";
        }
        finally
        {
            _procesando = false;
        }
    }

    private async Task AsignarCategoriaAsync()
    {
        if (string.IsNullOrWhiteSpace(_categoriaSeleccionadaId))
        {
            return;
        }

        _errorMessage = null;
        _procesando = true;

        try
        {
            await Sender.Send(new AsignarCategoriaAlertaCommand(VehiculoId, Guid.Parse(_categoriaSeleccionadaId)));
            _categoriaSeleccionadaId = null;
            await CargarAsync();
        }
        catch (Exception)
        {
            _errorMessage = "No se pudo asignar la categoría de alerta.";
        }
        finally
        {
            _procesando = false;
        }
    }

    private async Task DarDeBajaAsync()
    {
        _errorMessage = null;
        _procesando = true;

        try
        {
            await Sender.Send(new DarDeBajaVehiculoCommand(VehiculoId, DateOnly.FromDateTime(_fechaBaja)));
            await CargarAsync();
        }
        catch (Exception)
        {
            _errorMessage = "No se pudo dar de baja el vehículo.";
        }
        finally
        {
            _procesando = false;
        }
    }
}
