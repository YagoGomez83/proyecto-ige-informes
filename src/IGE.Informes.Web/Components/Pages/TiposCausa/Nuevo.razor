@page "/tipos-causa/nuevo"
@attribute [Authorize(Roles = "Analista,Supervisor,Admin")]
@using System.ComponentModel.DataAnnotations
@using FluentValidation
@using IGE.Informes.Application.TipoCausa.Commands.CrearTipoCausa
@using MediatR
@inject ISender Sender
@inject NavigationManager NavigationManager

<PageTitle>Nuevo Tipo de Causa · IGE 4.0</PageTitle>

<h1 class="headline-md mb-3">Nuevo Tipo de Causa</h1>

<div class="card card-form-sm">
    <EditForm Model="_input" OnValidSubmit="RegistrarAsync" FormName="nuevo-tipo-causa">
        <DataAnnotationsValidator />

        @if (_errorMessage is not null)
        {
            <div class="status-chip status-chip--alert mb-3">@_errorMessage</div>
        }

        <div class="mb-3">
            <label class="label-md" for="nombre">Nombre</label>
            <InputText id="nombre" class="form-control" @bind-Value="_input.Nombre" placeholder="Ej: AV. ROBO CALIFICADO" />
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn-primary" disabled="@_guardando">Guardar Tipo de Causa</button>
            <a class="btn-secondary" href="tipos-causa">Cancelar</a>
        </div>
    </EditForm>
</div>

@code {
    private readonly InputModel _input = new();
    private string? _errorMessage;
    private bool _guardando;

    private async Task RegistrarAsync()
    {
        _errorMessage = null;
        _guardando = true;

        try
        {
            await Sender.Send(new CrearTipoCausaCommand(_input.Nombre));

            NavigationManager.NavigateTo("tipos-causa");
        }
        catch (FluentValidation.ValidationException ex)
        {
            _errorMessage = string.Join(" ", ex.Errors.Select(e => e.ErrorMessage));
        }
        catch (Exception)
        {
            _errorMessage = "No se pudo registrar el Tipo de Causa. Verificá que el nombre no esté repetido.";
        }
        finally
        {
            _guardando = false;
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "El nombre es obligatorio.")]
        public string Nombre { get; set; } = string.Empty;
    }
}
