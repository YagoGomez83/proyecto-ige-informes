@page "/dependencias/{DependenciaId:guid}"
@attribute [Authorize]
@using IGE.Informes.Application.Barrios.Queries.ListarBarrios
@using IGE.Informes.Application.Common.Exceptions
@using IGE.Informes.Application.Dependencias.Commands.AsignarBarrioADependencia
@using IGE.Informes.Application.Dependencias.Commands.AsignarUnidadRegionalADependencia
@using IGE.Informes.Application.Dependencias.Commands.EliminarDependencia
@using IGE.Informes.Application.Dependencias.Queries.ListarDependencias
@using IGE.Informes.Application.Dependencias.Queries.ObtenerDependenciaPorId
@using IGE.Informes.Domain.Entities
@using MediatR
@inject ISender Sender
@inject NavigationManager NavigationManager

<PageTitle>Detalle de Dependencia · IGE 4.0</PageTitle>

@if (!_cargado)
{
    <p class="body-md">Cargando...</p>
}
else if (_dependencia is null)
{
    <p class="body-md">No se encontró la Dependencia solicitada.</p>
}
else
{
    <div class="d-flex justify-content-between align-items-start mb-3">
        <h1 class="headline-md mb-1">@_dependencia.Nombre</h1>
        <div class="d-flex gap-2">
            <AuthorizeView Roles="Admin">
                <Authorized>
                    <button type="button" class="btn-destructive" @onclick="() => _mostrarConfirmacionEliminar = true">Eliminar</button>
                </Authorized>
            </AuthorizeView>
            <a class="btn-secondary" href="dependencias">Volver al listado</a>
        </div>
    </div>

    @if (_mensajeExito is not null)
    {
        <div class="status-chip status-chip--safe mb-3">@_mensajeExito</div>
    }

    <div class="card mb-3">
        <h2 class="headline-sm mb-2">Datos generales</h2>
        <dl class="row mb-0">
            <dt class="col-sm-3 label-md">Tipo</dt>
            <dd class="col-sm-9 body-md">@_dependencia.Tipo</dd>

            @if (_dependencia.Tipo == TipoDependencia.Comisaria)
            {
                <dt class="col-sm-3 label-md">Unidad Regional</dt>
                <dd class="col-sm-9 body-md">@NombreUnidadRegional(_dependencia.UnidadRegionalId)</dd>
            }
        </dl>
    </div>

    <div class="card mb-3">
        <h2 class="headline-sm mb-2">Jurisdicción geográfica</h2>
        @if (_dependencia.BarrioIds.Count == 0)
        {
            <p class="body-md">Esta Dependencia no tiene Barrios asignados.</p>
        }
        else
        {
            <ul class="mb-0">
                @foreach (var barrioId in _dependencia.BarrioIds)
                {
                    <li class="body-md">@NombreBarrio(barrioId)</li>
                }
            </ul>
        }
    </div>

    <AuthorizeView Roles="Analista,Supervisor,Admin">
        <Authorized>
            <div class="card mb-3">
                <h2 class="headline-sm mb-2">Asignar Barrio</h2>
                <div class="d-flex align-items-end gap-2">
                    <div class="flex-grow-1">
                        <select class="form-control" @bind="_barrioSeleccionadoId">
                            <option value="">Seleccionar...</option>
                            @if (_barrios is not null)
                            {
                                @foreach (var barrio in _barrios)
                                {
                                    <option value="@barrio.Id">@barrio.Nombre</option>
                                }
                            }
                        </select>
                    </div>
                    <button type="button" class="btn-secondary" @onclick="AsignarBarrioAsync" disabled="@_procesando">Asignar</button>
                </div>
            </div>

            @if (_dependencia.Tipo == TipoDependencia.Comisaria)
            {
                <div class="card">
                    <h2 class="headline-sm mb-2">Asignar Unidad Regional</h2>
                    <div class="d-flex align-items-end gap-2">
                        <div class="flex-grow-1">
                            <select class="form-control" @bind="_unidadRegionalSeleccionadaId">
                                <option value="">Seleccionar...</option>
                                @if (_unidadesRegionales is not null)
                                {
                                    @foreach (var ur in _unidadesRegionales)
                                    {
                                        <option value="@ur.Id">@ur.Nombre</option>
                                    }
                                }
                            </select>
                        </div>
                        <button type="button" class="btn-secondary" @onclick="AsignarUnidadRegionalAsync" disabled="@_procesando">Asignar</button>
                    </div>
                </div>
            }
        </Authorized>
    </AuthorizeView>

    @if (_errorMessage is not null)
    {
        <div class="status-chip status-chip--alert mt-3">@_errorMessage</div>
    }

    <ConfirmacionModal Visible="_mostrarConfirmacionEliminar"
                        Titulo="Eliminar Dependencia"
                        Mensaje="@($"¿Confirmás eliminar la Dependencia \"{_dependencia.Nombre}\"? Esta acción no se puede deshacer.")"
                        TextoConfirmar="Eliminar"
                        Procesando="_eliminando"
                        OnConfirmar="EliminarAsync"
                        OnCancelar="() => _mostrarConfirmacionEliminar = false" />
}

@code {
    [Parameter]
    public Guid DependenciaId { get; set; }

    private DependenciaDto? _dependencia;
    private IReadOnlyCollection<BarrioDto>? _barrios;
    private IReadOnlyCollection<DependenciaDto>? _unidadesRegionales;
    private bool _cargado;
    private string? _barrioSeleccionadoId;
    private string? _unidadRegionalSeleccionadaId;
    private string? _errorMessage;
    private string? _mensajeExito;
    private bool _procesando;
    private bool _mostrarConfirmacionEliminar;
    private bool _eliminando;

    protected override async Task OnInitializedAsync()
    {
        _barrios = await Sender.Send(new ListarBarriosQuery());
        var todasLasDependencias = await Sender.Send(new ListarDependenciasQuery());
        _unidadesRegionales = todasLasDependencias.Where(d => d.Tipo == TipoDependencia.UnidadRegional).ToList();
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _dependencia = await Sender.Send(new ObtenerDependenciaPorIdQuery(DependenciaId));
        _cargado = true;
    }

    private string NombreBarrio(Guid barrioId) => _barrios?.FirstOrDefault(b => b.Id == barrioId)?.Nombre ?? barrioId.ToString();

    private string NombreUnidadRegional(Guid? unidadRegionalId)
    {
        if (unidadRegionalId is null)
        {
            return "—";
        }

        return _unidadesRegionales?.FirstOrDefault(u => u.Id == unidadRegionalId)?.Nombre ?? "—";
    }

    private async Task AsignarBarrioAsync()
    {
        if (string.IsNullOrWhiteSpace(_barrioSeleccionadoId))
        {
            return;
        }

        _errorMessage = null;
        _mensajeExito = null;
        _procesando = true;

        try
        {
            await Sender.Send(new AsignarBarrioADependenciaCommand(DependenciaId, Guid.Parse(_barrioSeleccionadoId)));
            _barrioSeleccionadoId = null;
            await CargarAsync();
            _mensajeExito = "Barrio asignado correctamente.";
        }
        catch (Exception)
        {
            _errorMessage = "No se pudo asignar el Barrio.";
        }
        finally
        {
            _procesando = false;
        }
    }

    private async Task AsignarUnidadRegionalAsync()
    {
        if (string.IsNullOrWhiteSpace(_unidadRegionalSeleccionadaId))
        {
            return;
        }

        _errorMessage = null;
        _mensajeExito = null;
        _procesando = true;

        try
        {
            await Sender.Send(new AsignarUnidadRegionalADependenciaCommand(DependenciaId, Guid.Parse(_unidadRegionalSeleccionadaId)));
            _unidadRegionalSeleccionadaId = null;
            await CargarAsync();
            _mensajeExito = "Unidad Regional asignada correctamente.";
        }
        catch (Exception)
        {
            _errorMessage = "No se pudo asignar la Unidad Regional.";
        }
        finally
        {
            _procesando = false;
        }
    }

    private async Task EliminarAsync()
    {
        _errorMessage = null;
        _eliminando = true;

        try
        {
            await Sender.Send(new EliminarDependenciaCommand(DependenciaId));
            NavigationManager.NavigateTo("dependencias");
        }
        catch (ReglaDeNegocioVioladaException ex)
        {
            _mostrarConfirmacionEliminar = false;
            _errorMessage = ex.Message;
        }
        catch (Exception)
        {
            _mostrarConfirmacionEliminar = false;
            _errorMessage = "No se pudo eliminar la Dependencia.";
        }
        finally
        {
            _eliminando = false;
        }
    }
}
