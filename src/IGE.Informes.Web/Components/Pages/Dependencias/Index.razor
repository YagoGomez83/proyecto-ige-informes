@page "/dependencias"
@attribute [Authorize]
@using IGE.Informes.Application.Common.Dtos
@using IGE.Informes.Application.Dependencias.Queries.ListarDependencias
@using IGE.Informes.Application.Dependencias.Queries.ListarDependenciasPaginado
@using MediatR
@inject ISender Sender

<PageTitle>Dependencias · IGE 4.0</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="headline-md">Dependencias</h1>
    <AuthorizeView Roles="Analista,Supervisor,Admin">
        <Authorized>
            <a class="btn-primary" href="dependencias/nueva">Nueva Dependencia</a>
        </Authorized>
    </AuthorizeView>
</div>

@if (_dependencias is null)
{
    <p class="body-md">Cargando...</p>
}
else if (_dependencias.Count == 0)
{
    <div class="card">
        <p class="body-md mb-0">Todavía no hay dependencias cargadas.</p>
    </div>
}
else
{
    <div class="card p-0">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th class="label-md">Nombre</th>
                    <th class="label-md">Tipo</th>
                    <th class="label-md">Barrios</th>
                    <th class="label-md"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var dependencia in _dependencias)
                {
                    <tr>
                        <td class="body-md">@dependencia.Nombre</td>
                        <td class="body-md">@dependencia.Tipo</td>
                        <td class="body-md">@dependencia.BarrioIds.Count</td>
                        <td class="text-end">
                            <a class="btn-secondary" href="@($"dependencias/{dependencia.Id}")">Ver</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <Paginador Pagina="_pagina" TotalPaginas="_resultado!.TotalPaginas" TotalItems="_resultado.TotalItems" PaginaCambiada="CambiarPaginaAsync" />
}

@code {
    private PagedResult<DependenciaDto>? _resultado;
    private IReadOnlyCollection<DependenciaDto>? _dependencias;
    private int _pagina = 1;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _resultado = await Sender.Send(new ListarDependenciasPaginadoQuery(_pagina));
        _dependencias = _resultado.Items;
    }

    private async Task CambiarPaginaAsync(int nuevaPagina)
    {
        _pagina = nuevaPagina;
        _dependencias = null;
        await CargarAsync();
    }
}
