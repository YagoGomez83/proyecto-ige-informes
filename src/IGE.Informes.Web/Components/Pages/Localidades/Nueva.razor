@page "/localidades/nueva"
@attribute [Authorize(Roles = "Admin")]
@using System.ComponentModel.DataAnnotations
@using FluentValidation
@using IGE.Informes.Application.Localidades.Commands.CrearLocalidad
@using MediatR
@inject ISender Sender
@inject NavigationManager NavigationManager

<PageTitle>Nueva Localidad · IGE 4.0</PageTitle>

<h1 class="headline-md mb-3">Nueva Localidad</h1>

<div class="card" style="max-width: 480px;">
    <EditForm Model="_input" OnValidSubmit="RegistrarAsync" FormName="nueva-localidad">
        <DataAnnotationsValidator />

        @if (_errorMessage is not null)
        {
            <div class="status-chip status-chip--alert mb-3">@_errorMessage</div>
        }

        <div class="mb-3">
            <label class="label-md" for="nombre">Nombre</label>
            <InputText id="nombre" class="form-control" @bind-Value="_input.Nombre" placeholder="Ej: Estancia Grande" />
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn-primary" disabled="@_guardando">Guardar Localidad</button>
            <a class="btn-secondary" href="localidades">Cancelar</a>
        </div>
    </EditForm>
</div>

@code {
    private readonly InputModel _input = new();
    private string? _errorMessage;
    private bool _guardando;

    private async Task RegistrarAsync()
    {
        _errorMessage = null;
        _guardando = true;

        try
        {
            await Sender.Send(new CrearLocalidadCommand(_input.Nombre));

            NavigationManager.NavigateTo("localidades");
        }
        catch (FluentValidation.ValidationException ex)
        {
            _errorMessage = string.Join(" ", ex.Errors.Select(e => e.ErrorMessage));
        }
        catch (Exception)
        {
            _errorMessage = "No se pudo registrar la Localidad. Verificá que el nombre no esté repetido.";
        }
        finally
        {
            _guardando = false;
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "El nombre es obligatorio.")]
        public string Nombre { get; set; } = string.Empty;
    }
}
