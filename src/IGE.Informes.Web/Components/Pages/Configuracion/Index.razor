@page "/configuracion"
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Configuración · IGE 4.0</PageTitle>

<h1 class="headline-md mb-3">Configuración</h1>

<div class="row g-3">
    <div class="col-md-4">
        <a class="card d-block" href="dependencias" style="text-decoration: none;">
            <h2 class="headline-sm mb-1">Dependencias</h2>
            <p class="body-sm mb-0">Alta y jurisdicción geográfica de Comisarías, Fiscalías y demás organismos.</p>
        </a>
    </div>
    <div class="col-md-4">
        <a class="card d-block" href="camaras" style="text-decoration: none;">
            <h2 class="headline-sm mb-1">Cámaras</h2>
            <p class="body-sm mb-0">Catálogo de cámaras Domo y LPR, con Dependencia opcional.</p>
        </a>
    </div>
    <div class="col-md-4">
        <a class="card d-block" href="barrios" style="text-decoration: none;">
            <h2 class="headline-sm mb-1">Barrios</h2>
            <p class="body-sm mb-0">Catálogo de zonas geográficas reutilizable como jurisdicción.</p>
        </a>
    </div>
    <div class="col-md-4">
        <a class="card d-block" href="localidades" style="text-decoration: none;">
            <h2 class="headline-sm mb-1">Localidades</h2>
            <p class="body-sm mb-0">Catálogo de ciudades/pueblos donde están instaladas las Cámaras.</p>
        </a>
    </div>
    <div class="col-md-4">
        <a class="card d-block" href="centros-control-camaras" style="text-decoration: none;">
            <h2 class="headline-sm mb-1">Centros de Control de Cámaras</h2>
            <p class="body-sm mb-0">Catálogo de los CCC que monitorean las Cámaras (San Luis, Villa Mercedes, Merlo, Justo Daract).</p>
        </a>
    </div>
    <div class="col-md-4">
        <a class="card d-block" href="tipos-incidente" style="text-decoration: none;">
            <h2 class="headline-sm mb-1">Tipos de Incidente</h2>
            <p class="body-sm mb-0">Catálogo de códigos de incidente para clasificar Casos de Análisis.</p>
        </a>
    </div>
    <div class="col-md-4">
        <a class="card d-block" href="usuarios" style="text-decoration: none;">
            <h2 class="headline-sm mb-1">Usuarios</h2>
            <p class="body-sm mb-0">Alta de usuarios, cambio de rol y bloqueo/desbloqueo de acceso.</p>
        </a>
    </div>
</div>
