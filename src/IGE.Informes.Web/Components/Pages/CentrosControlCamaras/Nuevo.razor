@page "/centros-control-camaras/nuevo"
@attribute [Authorize(Roles = "Admin")]
@using System.ComponentModel.DataAnnotations
@using FluentValidation
@using IGE.Informes.Application.CentrosControlCamaras.Commands.CrearCentroControlCamaras
@using MediatR
@inject ISender Sender
@inject NavigationManager NavigationManager

<PageTitle>Nuevo Centro de Control de Cámaras · IGE 4.0</PageTitle>

<h1 class="headline-md mb-3">Nuevo Centro de Control de Cámaras</h1>

<div class="card" style="max-width: 480px;">
    <EditForm Model="_input" OnValidSubmit="RegistrarAsync" FormName="nuevo-centro-control-camaras">
        <DataAnnotationsValidator />

        @if (_errorMessage is not null)
        {
            <div class="status-chip status-chip--alert mb-3">@_errorMessage</div>
        }

        <div class="mb-3">
            <label class="label-md" for="sigla">Sigla</label>
            <InputText id="sigla" class="form-control mono-data" @bind-Value="_input.Sigla" placeholder="Ej: CCCSL" />
        </div>

        <div class="mb-3">
            <label class="label-md" for="nombre">Nombre</label>
            <InputText id="nombre" class="form-control" @bind-Value="_input.Nombre" placeholder="Ej: Centro de Control de Cámaras San Luis" />
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn-primary" disabled="@_guardando">Guardar Centro de Control</button>
            <a class="btn-secondary" href="centros-control-camaras">Cancelar</a>
        </div>
    </EditForm>
</div>

@code {
    private readonly InputModel _input = new();
    private string? _errorMessage;
    private bool _guardando;

    private async Task RegistrarAsync()
    {
        _errorMessage = null;
        _guardando = true;

        try
        {
            await Sender.Send(new CrearCentroControlCamarasCommand(_input.Sigla, _input.Nombre));

            NavigationManager.NavigateTo("centros-control-camaras");
        }
        catch (FluentValidation.ValidationException ex)
        {
            _errorMessage = string.Join(" ", ex.Errors.Select(e => e.ErrorMessage));
        }
        catch (Exception)
        {
            _errorMessage = "No se pudo registrar el Centro de Control. Verificá que la sigla no esté repetida.";
        }
        finally
        {
            _guardando = false;
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "La sigla es obligatoria.")]
        public string Sigla { get; set; } = string.Empty;

        [Required(ErrorMessage = "El nombre es obligatorio.")]
        public string Nombre { get; set; } = string.Empty;
    }
}
