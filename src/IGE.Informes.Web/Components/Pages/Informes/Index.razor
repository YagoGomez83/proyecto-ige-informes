@page "/informes"
@attribute [Authorize]
@using IGE.Informes.Application.Common.Dtos
@using IGE.Informes.Application.Informes.Queries.ListarInformesPaginado
@using IGE.Informes.Domain.Entities
@using MediatR
@inject ISender Sender
@inject NavigationManager NavigationManager

<PageTitle>Informes · IGE 4.0</PageTitle>

<h1 class="headline-md mb-3">Informes</h1>

<div class="form-check mb-3">
    <input type="checkbox" class="form-check-input" id="soloSinCausa" @bind="_soloSinCausa" @bind:after="AplicarFiltroAsync" />
    <label class="form-check-label body-sm" for="soloSinCausa">Mostrar solo sin Causa</label>
</div>

@if (_informes is null)
{
    <p class="body-md">Cargando...</p>
}
else if (_informes.Count == 0)
{
    <div class="card">
        <p class="body-md mb-0">
            @(_soloSinCausa ? "No hay informes sin Causa vinculada." : "Todavía no hay informes cargados.")
        </p>
    </div>
}
else
{
    <div class="card p-0">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th class="label-md">ID Registro</th>
                    <th class="label-md">
                        <button type="button" class="btn-sort" @onclick="InvertirOrdenAsync">
                            Fecha de análisis
                            <span class="mono-data">@(_ordenDireccion == OrdenDireccion.Desc ? "▼" : "▲")</span>
                        </button>
                    </th>
                    <th class="label-md">Dependencia</th>
                    <th class="label-md">Causa</th>
                    <th class="label-md">Estado</th>
                    <th class="label-md"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var informe in _informes)
                {
                    <tr class="row-clickable" @onclick="@(() => IrAlInforme(informe.Id))">
                        <td class="body-sm mono-data">@informe.IdRegistro</td>
                        <td class="body-sm">@informe.FechaAnalisis.ToString("dd/MM/yyyy")</td>
                        <td class="body-sm">@informe.DependenciaNombre</td>
                        <td class="body-sm">
                            @if (informe.CausaCaratula is null)
                            {
                                <StatusChip Texto="Sin Causa" Semantica="ChipSemantica.Warning" />
                            }
                            else
                            {
                                @informe.CausaCaratula
                            }
                        </td>
                        <td class="body-sm">
                            @if (informe.Estado == EstadoInforme.Publicado)
                            {
                                <StatusChip Texto="Publicado" Semantica="ChipSemantica.Safe" />
                            }
                            else
                            {
                                <StatusChip Texto="Borrador" Semantica="ChipSemantica.Warning" />
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn-secondary" href="@($"informes/{informe.Id}")">Ver</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <Paginador Pagina="_pagina" TotalPaginas="_resultado!.TotalPaginas" TotalItems="_resultado.TotalItems" PaginaCambiada="CambiarPaginaAsync" />
}

@code {
    private PagedResult<InformeListadoDto>? _resultado;
    private IReadOnlyCollection<InformeListadoDto>? _informes;
    private int _pagina = 1;
    private OrdenDireccion _ordenDireccion = OrdenDireccion.Desc;
    private bool _soloSinCausa;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _resultado = await Sender.Send(new ListarInformesPaginadoQuery(_pagina, OrdenDireccion: _ordenDireccion, SoloSinCausa: _soloSinCausa));
        _informes = _resultado.Items;
    }

    private async Task CambiarPaginaAsync(int nuevaPagina)
    {
        _pagina = nuevaPagina;
        _informes = null;
        await CargarAsync();
    }

    private async Task InvertirOrdenAsync()
    {
        _ordenDireccion = _ordenDireccion == OrdenDireccion.Desc ? OrdenDireccion.Asc : OrdenDireccion.Desc;
        _pagina = 1;
        _informes = null;
        await CargarAsync();
    }

    private async Task AplicarFiltroAsync()
    {
        _pagina = 1;
        _informes = null;
        await CargarAsync();
    }

    private void IrAlInforme(Guid informeId) => NavigationManager.NavigateTo($"informes/{informeId}");
}
