@page "/informes/{InformeId:guid}/editar"
@attribute [Authorize]
@using IGE.Informes.Application.Common.Exceptions
@using IGE.Informes.Application.Dependencias.Commands.CrearDependencia
@using IGE.Informes.Application.Dependencias.Queries.ListarDependencias
@using IGE.Informes.Application.Informes.Commands.EditarInforme
@using IGE.Informes.Application.Informes.Commands.VincularPersonaInforme
@using IGE.Informes.Application.Informes.Commands.VincularVehiculoInforme
@using IGE.Informes.Application.Informes.Queries.ObtenerInformePorId
@using IGE.Informes.Application.Informes.Queries.SugerirCausas
@using IGE.Informes.Application.CategoriasAlerta.Queries.ListarCategoriasAlerta
@using IGE.Informes.Application.ColorVehiculo.Queries.ListarColorVehiculo
@using IGE.Informes.Application.MarcaVehiculo.Queries.ListarMarcaVehiculo
@using IGE.Informes.Application.Personas.Commands.RegistrarPersona
@using IGE.Informes.Application.Personas.Queries.BuscarPersonas
@using IGE.Informes.Application.TipoCausa.Commands.CrearTipoCausa
@using IGE.Informes.Application.TipoCausa.Queries.ListarTipoCausa
@using IGE.Informes.Application.Vehiculos.Commands.RegistrarVehiculo
@using IGE.Informes.Application.Vehiculos.Queries.BuscarVehiculos
@using IGE.Informes.Application.Vehiculos.Queries.ListarVehiculos
@using IGE.Informes.Domain.Entities
@using MediatR
@inject ISender Sender
@inject NavigationManager NavigationManager

<PageTitle>Editar Informe · IGE 4.0</PageTitle>

@if (!_cargado)
{
    <p class="body-md">Cargando...</p>
}
else if (_informe is null)
{
    <p class="body-md">No se encontró el informe solicitado.</p>
}
else if (_informe.Estado == EstadoInforme.Publicado)
{
    <div class="status-chip status-chip--warning mb-3">
        Este Informe ya está Publicado y es inmutable — no se pueden editar sus metadatos.
    </div>
    <a class="btn-secondary" href="@($"informes/{_informe.Id}")">Volver al Informe</a>
}
else
{
    <h1 class="headline-md mb-3 mono-data">Editar Informe @_informe.IdRegistro</h1>

    @if (_errorMessage is not null)
    {
        <div class="status-chip status-chip--alert mb-3">@_errorMessage</div>
    }

    <div class="row g-3">
        <div class="col-lg-6">
            <div class="card card-form-md">
                <div class="mb-3">
                    <label class="label-md" for="idRegistro">ID Registro</label>
                    <input id="idRegistro" class="form-control mono-data" @bind="_idRegistro" />
                </div>

                <div class="mb-3">
                    <label class="label-md" for="fechaAnalisis">Fecha de Análisis</label>
                    <input id="fechaAnalisis" type="date" class="form-control" @bind="_fechaAnalisis" />
                </div>

                <div class="mb-3">
                    <label class="label-md" for="relato">Relato</label>
                    <textarea id="relato" class="form-control" rows="6" @bind="_relato"></textarea>
                </div>

                <div class="mb-3">
                    <label class="label-md" for="dependenciaDestino">Dependencia destino</label>
                    <ComboboxBuscable TValor="string"
                                      Opciones="@OpcionesDependencias"
                                      ValorSeleccionado="_dependenciaDestinoId"
                                      ValorSeleccionadoChanged="@(v => _dependenciaDestinoId = v ?? string.Empty)"
                                      Placeholder="Buscar Dependencia..." />

                    <AuthorizeView Roles="Admin">
                        <Authorized>
                            @if (!_mostrandoNuevaDependencia)
                            {
                                <button type="button" class="btn-secondary mt-2" @onclick="() => _mostrandoNuevaDependencia = true">
                                    + Nueva Dependencia
                                </button>
                            }
                            else
                            {
                                <div class="card mt-2 p-3">
                                    @if (_errorNuevaDependencia is not null)
                                    {
                                        <div class="status-chip status-chip--alert mb-2">@_errorNuevaDependencia</div>
                                    }

                                    <div class="mb-2">
                                        <label class="label-md" for="nuevaDependenciaNombre">Nombre</label>
                                        <input id="nuevaDependenciaNombre" class="form-control" placeholder="Ej: Departamento Investigaciones"
                                               @bind="_nuevaDependenciaNombre" />
                                    </div>

                                    <div class="mb-2">
                                        <label class="label-md" for="nuevaDependenciaTipo">Tipo</label>
                                        <select id="nuevaDependenciaTipo" class="form-control" @bind="_nuevaDependenciaTipo">
                                            <option value="@TipoDependencia.Comisaria">Comisaría</option>
                                            <option value="@TipoDependencia.Fiscalia">Fiscalía</option>
                                            <option value="@TipoDependencia.Juzgado">Juzgado</option>
                                            <option value="@TipoDependencia.Division">División</option>
                                            <option value="@TipoDependencia.UnidadRegional">Unidad Regional</option>
                                        </select>
                                    </div>

                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn-primary" @onclick="CrearDependenciaAsync" disabled="@_creandoDependencia">
                                            Guardar Dependencia
                                        </button>
                                        <button type="button" class="btn-secondary" @onclick="CancelarNuevaDependencia">Cancelar</button>
                                    </div>
                                </div>
                            }
                        </Authorized>
                    </AuthorizeView>
                </div>

                <div class="mb-3">
                    <label class="label-md" for="causaCaratula">Carátula de la Causa</label>
                    <ComboboxBuscable TValor="string"
                                      Opciones="@OpcionesCausas"
                                      ValorSeleccionado="_causaCaratula"
                                      ValorSeleccionadoChanged="OnCausaSeleccionadaAsync"
                                      Placeholder="Buscar Carátula..." />

                    <AuthorizeView Roles="Admin">
                        <Authorized>
                            @if (!_mostrandoNuevoTipoCausa)
                            {
                                <button type="button" class="btn-secondary mt-2" @onclick="() => _mostrandoNuevoTipoCausa = true">
                                    + Nuevo Tipo de Causa
                                </button>
                            }
                            else
                            {
                                <div class="card mt-2 p-3">
                                    @if (_errorNuevoTipoCausa is not null)
                                    {
                                        <div class="status-chip status-chip--alert mb-2">@_errorNuevoTipoCausa</div>
                                    }

                                    <div class="mb-2">
                                        <label class="label-md" for="nuevoTipoCausaNombre">Nombre</label>
                                        <input id="nuevoTipoCausaNombre" class="form-control" placeholder="Ej: AV. ROBO CALIFICADO"
                                               @bind="_nuevoTipoCausaNombre" />
                                    </div>

                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn-primary" @onclick="CrearTipoCausaAsync" disabled="@_creandoTipoCausa">
                                            Guardar Tipo de Causa
                                        </button>
                                        <button type="button" class="btn-secondary" @onclick="CancelarNuevoTipoCausa">Cancelar</button>
                                    </div>
                                </div>
                            }
                        </Authorized>
                    </AuthorizeView>
                </div>

                <div class="mb-3">
                    <label class="label-md" for="piezaSumarial">N° de pieza sumarial</label>
                    <input id="piezaSumarial" class="form-control mono-data" @bind="_piezaSumarial" @bind:after="BuscarSugerenciasDeCausaAsync"
                           placeholder="Dejar vacío si la Dependencia no aporta un número real" />
                </div>

                <div class="mb-3">
                    <label class="label-md" for="circunscripcion">Circunscripción judicial</label>
                    <select id="circunscripcion" class="form-control" @bind="_circunscripcion">
                        <option value=""></option>
                        @if (!string.IsNullOrWhiteSpace(_circunscripcion)
                            && _circunscripcion != "Primera" && _circunscripcion != "Segunda" && _circunscripcion != "Tercera")
                        {
                            <option value="@_circunscripcion">@_circunscripcion (valor actual, fuera de las opciones)</option>
                        }
                        <option value="Primera">Primera</option>
                        <option value="Segunda">Segunda</option>
                        <option value="Tercera">Tercera</option>
                    </select>
                </div>

                @if (_causasSugeridas is { Count: > 0 })
                {
                    <div class="mb-3">
                        <p class="body-sm mb-1">
                            Ninguna Causa existente tiene exactamente ese N° de pieza sumarial —
                            ¿es alguna de estas?
                        </p>
                        @foreach (var sugerencia in _causasSugeridas)
                        {
                            <button type="button" class="btn-secondary mb-1 d-block" @onclick="() => UsarCausaSugerida(sugerencia)">
                                @sugerencia.Caratula
                                <span class="mono-data">(@(sugerencia.NroPiezaSumarial ?? "sin N° de pieza sumarial"))</span>
                                — @sugerencia.CircunscripcionJudicial
                            </button>
                        }
                    </div>
                }

                <div class="d-flex gap-2">
                    <button type="button" class="btn-primary" @onclick="GuardarAsync" disabled="@_guardando">Guardar cambios</button>
                    <a class="btn-secondary" href="@($"informes/{_informe.Id}")">Cancelar</a>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card h-100 p-0">
                <h2 class="headline-sm m-3 mb-2">PDF</h2>
                @if (_informe.PdfUrl is not null)
                {
                    <iframe src="@_informe.PdfUrl" class="informe-pdf-visor" title="Vista previa del PDF del Informe"></iframe>
                }
                else
                {
                    <p class="body-md mx-3 mb-3">Pendiente de carga.</p>
                }
            </div>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-lg-6">
            <div class="card h-100">
                <h2 class="headline-sm mb-2">Vehículos vinculados</h2>
                @if (_informe.VehiculosVinculados.Count == 0)
                {
                    <p class="body-md">Ningún vehículo vinculado todavía.</p>
                }
                else
                {
                    <ul class="mb-3">
                        @foreach (var vehiculo in _informe.VehiculosVinculados)
                        {
                            <li class="body-sm">
                                <a href="@($"vehiculos/{vehiculo.Id}")">@vehiculo.Marca @vehiculo.Modelo</a>
                                @if (vehiculo.Dominio is not null)
                                {
                                    <span class="mono-data"> — @vehiculo.Dominio</span>
                                }
                            </li>
                        }
                    </ul>
                }

                <div class="d-flex gap-2">
                    <input class="form-control mono-data" @bind="_dominioBuscado" @bind:event="oninput" placeholder="Buscar por dominio..." disabled="@_vinculando" />
                    <button type="button" class="btn-secondary" @onclick="BuscarVehiculosAsync" disabled="@_vinculando">Buscar</button>
                </div>

                @if (_resultadosVehiculos is not null)
                {
                    @if (_resultadosVehiculos.Count == 0)
                    {
                        <p class="body-sm mt-2 mb-0">Sin resultados.</p>
                    }
                    else
                    {
                        <ul class="mt-2 mb-0">
                            @foreach (var resultado in _resultadosVehiculos)
                            {
                                <li class="body-sm">
                                    @resultado.Marca @resultado.Modelo (@resultado.Dominio)
                                    <button type="button" class="btn-secondary" @onclick="() => VincularVehiculoAsync(resultado.Id)" disabled="@_vinculando">Vincular</button>
                                </li>
                            }
                        </ul>
                    }
                }

                @if (!_mostrandoNuevoVehiculo)
                {
                    <button type="button" class="btn-secondary mt-2" @onclick="() => _mostrandoNuevoVehiculo = true">
                        + Nuevo Vehículo
                    </button>
                }
                else
                {
                    <div class="card mt-2 p-3">
                        @if (_errorNuevoVehiculo is not null)
                        {
                            <div class="status-chip status-chip--alert mb-2">@_errorNuevoVehiculo</div>
                        }

                        <div class="mb-2">
                            <label class="label-md" for="nuevoVehiculoMarca">Marca</label>
                            <select id="nuevoVehiculoMarca" class="form-control" @bind="_nuevoVehiculoMarcaSeleccionada">
                                <option value="">Seleccionar...</option>
                                @if (_marcasVehiculo is not null)
                                {
                                    @foreach (var marca in _marcasVehiculo)
                                    {
                                        <option value="@marca.Nombre">@marca.Nombre</option>
                                    }
                                }
                                <option value="@OtraOpcionMarcaColor">Otra (especificar)</option>
                            </select>
                            @if (_nuevoVehiculoMarcaSeleccionada == OtraOpcionMarcaColor)
                            {
                                <input class="form-control mt-2" placeholder="Marca no listada" @bind="_nuevoVehiculoMarca" @bind:event="oninput" />
                            }
                        </div>

                        <div class="mb-2">
                            <label class="label-md" for="nuevoVehiculoModelo">Modelo</label>
                            <input id="nuevoVehiculoModelo" class="form-control" @bind="_nuevoVehiculoModelo" />
                        </div>

                        <div class="mb-2">
                            <label class="label-md" for="nuevoVehiculoColor">Color</label>
                            <select id="nuevoVehiculoColor" class="form-control" @bind="_nuevoVehiculoColorSeleccionado">
                                <option value="">Seleccionar...</option>
                                @if (_coloresVehiculo is not null)
                                {
                                    @foreach (var color in _coloresVehiculo)
                                    {
                                        <option value="@color.Nombre">@color.Nombre</option>
                                    }
                                }
                                <option value="@OtraOpcionMarcaColor">Otra (especificar)</option>
                            </select>
                            @if (_nuevoVehiculoColorSeleccionado == OtraOpcionMarcaColor)
                            {
                                <input class="form-control mt-2" placeholder="Color no listado" @bind="_nuevoVehiculoColor" @bind:event="oninput" />
                            }
                        </div>

                        <div class="mb-2">
                            <label class="label-md" for="nuevoVehiculoDominio">Dominio (opcional)</label>
                            <input id="nuevoVehiculoDominio" class="form-control mono-data" @bind="_nuevoVehiculoDominio" />
                        </div>

                        <div class="mb-2">
                            <label class="label-md" for="nuevoVehiculoDominioCerteza">Certeza del dominio</label>
                            <select id="nuevoVehiculoDominioCerteza" class="form-control" @bind="_nuevoVehiculoDominioCerteza">
                                <option value="@CertezaDominio.Confirmado">Confirmado</option>
                                <option value="@CertezaDominio.Parcial">Parcial</option>
                                <option value="@CertezaDominio.Incierto">Incierto</option>
                            </select>
                        </div>

                        <div class="mb-2">
                            <label class="label-md" for="nuevoVehiculoAccion">Acción a realizar</label>
                            <select id="nuevoVehiculoAccion" class="form-control" @bind="_nuevoVehiculoAccionARealizar">
                                <option value="@AccionARealizar.Detener">Detener</option>
                                <option value="@AccionARealizar.Identificar">Identificar</option>
                                <option value="@AccionARealizar.SinAccion">Sin acción (solo referencia)</option>
                            </select>
                        </div>

                        <div class="mb-2">
                            <label class="label-md" for="nuevoVehiculoAvisarA">Avisar a</label>
                            <input id="nuevoVehiculoAvisarA" class="form-control" @bind="_nuevoVehiculoAvisarA" />
                        </div>

                        <div class="mb-2">
                            <label class="label-md">Categorías de alerta</label>
                            @if (_categoriasAlerta is not null)
                            {
                                @foreach (var categoria in _categoriasAlerta)
                                {
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="@($"nuevoVehiculoCategoria-{categoria.Id}")"
                                               checked="@_nuevoVehiculoCategoriasAlertaIds.Contains(categoria.Id)"
                                               @onchange="@(e => AlternarCategoriaAlertaNuevoVehiculo(categoria.Id, (bool)e.Value!))" />
                                        <label class="form-check-label body-sm" for="@($"nuevoVehiculoCategoria-{categoria.Id}")">@categoria.Nombre</label>
                                    </div>
                                }
                            }
                        </div>

                        <div class="mb-2">
                            <label class="label-md" for="nuevoVehiculoCaracteristicas">Características (opcional)</label>
                            <textarea id="nuevoVehiculoCaracteristicas" class="form-control" rows="2" @bind="_nuevoVehiculoCaracteristicas"></textarea>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="button" class="btn-primary" @onclick="CrearYVincularVehiculoAsync" disabled="@_creandoVehiculo">
                                Guardar y vincular
                            </button>
                            <button type="button" class="btn-secondary" @onclick="CancelarNuevoVehiculo">Cancelar</button>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card h-100">
                <h2 class="headline-sm mb-2">Personas vinculadas</h2>
                @if (_informe.PersonasVinculadas.Count == 0)
                {
                    <p class="body-md">Ninguna persona vinculada todavía.</p>
                }
                else
                {
                    <ul class="mb-3">
                        @foreach (var persona in _informe.PersonasVinculadas)
                        {
                            <li class="body-sm">
                                <a href="@($"personas/{persona.Id}")">@(persona.Nombre ?? "Sin identificar")</a>
                                @if (persona.Dni is not null)
                                {
                                    <span class="mono-data"> — @persona.Dni</span>
                                }
                            </li>
                        }
                    </ul>
                }

                <div class="d-flex gap-2">
                    <input class="form-control mono-data" @bind="_dniBuscado" @bind:event="oninput" placeholder="Buscar por DNI..." disabled="@_vinculando" />
                    <button type="button" class="btn-secondary" @onclick="BuscarPersonasAsync" disabled="@_vinculando">Buscar</button>
                </div>

                @if (_resultadosPersonas is not null)
                {
                    @if (_resultadosPersonas.Count == 0)
                    {
                        <p class="body-sm mt-2 mb-0">Sin resultados.</p>
                    }
                    else
                    {
                        <ul class="mt-2 mb-0">
                            @foreach (var resultado in _resultadosPersonas)
                            {
                                <li class="body-sm">
                                    @(resultado.Nombre ?? "Sin identificar") (@(resultado.Dni ?? "sin DNI"))
                                    <button type="button" class="btn-secondary" @onclick="() => VincularPersonaAsync(resultado.Id)" disabled="@_vinculando">Vincular</button>
                                </li>
                            }
                        </ul>
                    }
                }

                @if (!_mostrandoNuevaPersona)
                {
                    <button type="button" class="btn-secondary mt-2" @onclick="() => _mostrandoNuevaPersona = true">
                        + Nueva Persona
                    </button>
                }
                else
                {
                    <div class="card mt-2 p-3">
                        @if (_errorNuevaPersona is not null)
                        {
                            <div class="status-chip status-chip--alert mb-2">@_errorNuevaPersona</div>
                        }

                        <div class="mb-2">
                            <label class="label-md" for="nuevaPersonaRol">Rol</label>
                            <select id="nuevaPersonaRol" class="form-control" @bind="_nuevaPersonaRol">
                                <option value="@RolPersona.Denunciante">Denunciante</option>
                                <option value="@RolPersona.Damnificado">Damnificado</option>
                                <option value="@RolPersona.Sospechoso">Sospechoso</option>
                                <option value="@RolPersona.ConductorIdentificado">Conductor identificado</option>
                                <option value="@RolPersona.Testigo">Testigo</option>
                            </select>
                        </div>

                        <div class="mb-2">
                            <label class="label-md" for="nuevaPersonaNombre">Nombre (dejar vacío si no está identificada)</label>
                            <input id="nuevaPersonaNombre" class="form-control" @bind="_nuevaPersonaNombre" />
                        </div>

                        <div class="mb-2">
                            <label class="label-md" for="nuevaPersonaDni">DNI (opcional)</label>
                            <input id="nuevaPersonaDni" class="form-control mono-data" @bind="_nuevaPersonaDni" />
                        </div>

                        <div class="mb-2">
                            <label class="label-md" for="nuevaPersonaCaracteristicas">Características (obligatorio si no está identificada)</label>
                            <textarea id="nuevaPersonaCaracteristicas" class="form-control" rows="2" @bind="_nuevaPersonaCaracteristicas"></textarea>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="button" class="btn-primary" @onclick="CrearYVincularPersonaAsync" disabled="@_creandoPersona">
                                Guardar y vincular
                            </button>
                            <button type="button" class="btn-secondary" @onclick="CancelarNuevaPersona">Cancelar</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid InformeId { get; set; }

    private InformeDto? _informe;
    private IReadOnlyCollection<DependenciaDto>? _dependencias;
    private bool _cargado;
    private bool _guardando;
    private string? _errorMessage;

    private string? _idRegistro;
    private DateOnly _fechaAnalisis;
    private string? _relato;
    private string _dependenciaDestinoId = string.Empty;
    private string? _causaCaratula;
    private string? _piezaSumarial;
    private string? _circunscripcion;
    private IReadOnlyCollection<CausaSugeridaDto>? _causasSugeridas;

    private bool _mostrandoNuevaDependencia;
    private string _nuevaDependenciaNombre = string.Empty;
    private TipoDependencia _nuevaDependenciaTipo = TipoDependencia.Comisaria;
    private bool _creandoDependencia;
    private string? _errorNuevaDependencia;

    private IReadOnlyCollection<TipoCausaDto>? _tiposCausa;
    private bool _mostrandoNuevoTipoCausa;
    private string _nuevoTipoCausaNombre = string.Empty;
    private bool _creandoTipoCausa;
    private string? _errorNuevoTipoCausa;

    private IReadOnlyCollection<(string Valor, string Texto)> OpcionesDependencias =>
        _dependencias?.Select(d => (d.Id.ToString(), d.Nombre)).ToList() ?? [];

    private IReadOnlyCollection<(string Valor, string Texto)> OpcionesCausas
    {
        get
        {
            var opciones = _tiposCausa?.Select(t => (t.Nombre, t.Nombre)).ToList() ?? [];

            // El valor actual puede no estar en el catálogo (ej. Informe
            // migrado con una carátula que después se corrigió/eliminó del
            // catálogo) — se agrega igual para no perder la selección.
            if (_causaCaratula is not null && opciones.All(o => o.Item1 != _causaCaratula))
            {
                opciones.Insert(0, (_causaCaratula, $"{_causaCaratula} (valor actual, no está en el catálogo)"));
            }

            return opciones;
        }
    }

    private string _dominioBuscado = string.Empty;
    private string _dniBuscado = string.Empty;
    private IReadOnlyCollection<VehiculoResumenDto>? _resultadosVehiculos;
    private IReadOnlyCollection<PersonaBusquedaResultDto>? _resultadosPersonas;
    private bool _vinculando;

    private IReadOnlyCollection<CategoriaAlertaDto>? _categoriasAlerta;
    private IReadOnlyCollection<MarcaVehiculoDto>? _marcasVehiculo;
    private IReadOnlyCollection<ColorVehiculoDto>? _coloresVehiculo;

    private const string OtraOpcionMarcaColor = "__otra__";

    private bool _mostrandoNuevoVehiculo;
    private string _nuevoVehiculoMarcaSeleccionada = string.Empty;
    private string _nuevoVehiculoMarca = string.Empty;
    private string _nuevoVehiculoModelo = string.Empty;
    private string _nuevoVehiculoColorSeleccionado = string.Empty;
    private string _nuevoVehiculoColor = string.Empty;
    private string? _nuevoVehiculoDominio;
    private CertezaDominio _nuevoVehiculoDominioCerteza = CertezaDominio.Incierto;
    private AccionARealizar _nuevoVehiculoAccionARealizar = AccionARealizar.Detener;
    private string _nuevoVehiculoAvisarA = string.Empty;
    private string? _nuevoVehiculoCaracteristicas;
    private readonly List<Guid> _nuevoVehiculoCategoriasAlertaIds = [];
    private bool _creandoVehiculo;
    private string? _errorNuevoVehiculo;

    private bool _mostrandoNuevaPersona;
    private RolPersona _nuevaPersonaRol = RolPersona.Testigo;
    private string? _nuevaPersonaNombre;
    private string? _nuevaPersonaDni;
    private string? _nuevaPersonaCaracteristicas;
    private bool _creandoPersona;
    private string? _errorNuevaPersona;

    protected override async Task OnInitializedAsync()
    {
        _informe = await Sender.Send(new ObtenerInformePorIdQuery(InformeId));
        _dependencias = await Sender.Send(new ListarDependenciasQuery());
        _tiposCausa = await Sender.Send(new ListarTipoCausaQuery());
        _categoriasAlerta = await Sender.Send(new ListarCategoriasAlertaQuery());
        _marcasVehiculo = await Sender.Send(new ListarMarcaVehiculoQuery());
        _coloresVehiculo = await Sender.Send(new ListarColorVehiculoQuery());

        if (_informe is not null)
        {
            _idRegistro = _informe.IdRegistro;
            _fechaAnalisis = _informe.FechaAnalisis;
            _relato = _informe.Relato;
            _dependenciaDestinoId = _informe.DependenciaDestinoId.ToString();
            _causaCaratula = _informe.CausaCaratula;
            _piezaSumarial = _informe.CausaNroPiezaSumarial;
            _circunscripcion = _informe.CausaCircunscripcionJudicial;
        }

        _cargado = true;
    }

    private async Task BuscarSugerenciasDeCausaAsync()
    {
        _causasSugeridas = null;

        if (string.IsNullOrWhiteSpace(_causaCaratula) || string.IsNullOrWhiteSpace(_piezaSumarial))
        {
            return;
        }

        // Si ya hay una Causa con exactamente ese N° de pieza sumarial, el
        // Handler la va a reusar directamente al guardar (ver
        // EditarInformeCommandHandler) — no tiene sentido mostrar
        // sugerencias en ese caso, solo cuando no hay match exacto.
        var sugerencias = await Sender.Send(new SugerirCausasQuery(_causaCaratula));
        _causasSugeridas = sugerencias
            .Where(c => c.NroPiezaSumarial != _piezaSumarial)
            .ToList();
    }

    private async Task OnCausaSeleccionadaAsync(string? causaCaratula)
    {
        _causaCaratula = causaCaratula;
        await BuscarSugerenciasDeCausaAsync();
    }

    private void UsarCausaSugerida(CausaSugeridaDto sugerencia)
    {
        _causaCaratula = sugerencia.Caratula;
        _piezaSumarial = sugerencia.NroPiezaSumarial;
        _circunscripcion = sugerencia.CircunscripcionJudicial;
        _causasSugeridas = null;
    }

    private void CancelarNuevaDependencia()
    {
        _mostrandoNuevaDependencia = false;
        _nuevaDependenciaNombre = string.Empty;
        _nuevaDependenciaTipo = TipoDependencia.Comisaria;
        _errorNuevaDependencia = null;
    }

    private async Task CrearDependenciaAsync()
    {
        if (string.IsNullOrWhiteSpace(_nuevaDependenciaNombre))
        {
            _errorNuevaDependencia = "El nombre es obligatorio.";
            return;
        }

        _errorNuevaDependencia = null;
        _creandoDependencia = true;

        try
        {
            var dependenciaId = await Sender.Send(new CrearDependenciaCommand(_nuevaDependenciaNombre, _nuevaDependenciaTipo));

            // Recargar el catálogo completo (en vez de agregar la entrada a
            // mano a _dependencias) para que el <select> quede consistente
            // con lo que devolvería la Query en una carga nueva de la
            // página — mismo criterio que ListarDependenciasQuery ya usa
            // en OnInitializedAsync.
            _dependencias = await Sender.Send(new ListarDependenciasQuery());
            _dependenciaDestinoId = dependenciaId.ToString();

            CancelarNuevaDependencia();
        }
        catch (FluentValidation.ValidationException ex)
        {
            _errorNuevaDependencia = string.Join(" ", ex.Errors.Select(e => e.ErrorMessage));
        }
        catch (Exception)
        {
            _errorNuevaDependencia = "No se pudo crear la Dependencia. Verificá que el nombre no esté repetido.";
        }
        finally
        {
            _creandoDependencia = false;
        }
    }

    private void CancelarNuevoTipoCausa()
    {
        _mostrandoNuevoTipoCausa = false;
        _nuevoTipoCausaNombre = string.Empty;
        _errorNuevoTipoCausa = null;
    }

    private async Task CrearTipoCausaAsync()
    {
        if (string.IsNullOrWhiteSpace(_nuevoTipoCausaNombre))
        {
            _errorNuevoTipoCausa = "El nombre es obligatorio.";
            return;
        }

        _errorNuevoTipoCausa = null;
        _creandoTipoCausa = true;

        try
        {
            await Sender.Send(new CrearTipoCausaCommand(_nuevoTipoCausaNombre));

            // Recargar el catálogo completo, mismo criterio que
            // CrearDependenciaAsync — el <select> queda consistente con lo
            // que devolvería la Query en una carga nueva de la página.
            _tiposCausa = await Sender.Send(new ListarTipoCausaQuery());
            _causaCaratula = _nuevoTipoCausaNombre;

            CancelarNuevoTipoCausa();
            await BuscarSugerenciasDeCausaAsync();
        }
        catch (FluentValidation.ValidationException ex)
        {
            _errorNuevoTipoCausa = string.Join(" ", ex.Errors.Select(e => e.ErrorMessage));
        }
        catch (Exception)
        {
            _errorNuevoTipoCausa = "No se pudo crear el Tipo de Causa. Verificá que el nombre no esté repetido.";
        }
        finally
        {
            _creandoTipoCausa = false;
        }
    }

    private async Task BuscarVehiculosAsync()
    {
        if (string.IsNullOrWhiteSpace(_dominioBuscado) || _dominioBuscado.Trim().Length < 3)
        {
            _errorMessage = "Ingresá al menos 3 caracteres para buscar.";
            return;
        }

        _errorMessage = null;
        _resultadosVehiculos = await Sender.Send(new BuscarVehiculosQuery(_dominioBuscado));
    }

    private async Task BuscarPersonasAsync()
    {
        if (string.IsNullOrWhiteSpace(_dniBuscado) || _dniBuscado.Trim().Length < 3)
        {
            _errorMessage = "Ingresá al menos 3 caracteres para buscar.";
            return;
        }

        _errorMessage = null;
        _resultadosPersonas = await Sender.Send(new BuscarPersonasQuery(_dniBuscado));
    }

    private async Task VincularVehiculoAsync(Guid vehiculoId)
    {
        _errorMessage = null;
        _vinculando = true;

        try
        {
            await Sender.Send(new VincularVehiculoInformeCommand(InformeId, vehiculoId));
            _resultadosVehiculos = null;
            _dominioBuscado = string.Empty;
            _informe = await Sender.Send(new ObtenerInformePorIdQuery(InformeId));
        }
        catch (Exception)
        {
            _errorMessage = "No se pudo vincular el vehículo.";
        }
        finally
        {
            _vinculando = false;
        }
    }

    private async Task VincularPersonaAsync(Guid personaId)
    {
        _errorMessage = null;
        _vinculando = true;

        try
        {
            await Sender.Send(new VincularPersonaInformeCommand(InformeId, personaId));
            _resultadosPersonas = null;
            _dniBuscado = string.Empty;
            _informe = await Sender.Send(new ObtenerInformePorIdQuery(InformeId));
        }
        catch (Exception)
        {
            _errorMessage = "No se pudo vincular la persona.";
        }
        finally
        {
            _vinculando = false;
        }
    }

    private void AlternarCategoriaAlertaNuevoVehiculo(Guid categoriaId, bool marcada)
    {
        if (marcada)
        {
            _nuevoVehiculoCategoriasAlertaIds.Add(categoriaId);
        }
        else
        {
            _nuevoVehiculoCategoriasAlertaIds.Remove(categoriaId);
        }
    }

    private void CancelarNuevoVehiculo()
    {
        _mostrandoNuevoVehiculo = false;
        _nuevoVehiculoMarcaSeleccionada = string.Empty;
        _nuevoVehiculoMarca = string.Empty;
        _nuevoVehiculoModelo = string.Empty;
        _nuevoVehiculoColorSeleccionado = string.Empty;
        _nuevoVehiculoColor = string.Empty;
        _nuevoVehiculoDominio = null;
        _nuevoVehiculoDominioCerteza = CertezaDominio.Incierto;
        _nuevoVehiculoAccionARealizar = AccionARealizar.Detener;
        _nuevoVehiculoAvisarA = string.Empty;
        _nuevoVehiculoCaracteristicas = null;
        _nuevoVehiculoCategoriasAlertaIds.Clear();
        _errorNuevoVehiculo = null;
    }

    private async Task CrearYVincularVehiculoAsync()
    {
        var marcaFinal = _nuevoVehiculoMarcaSeleccionada == OtraOpcionMarcaColor ? _nuevoVehiculoMarca : _nuevoVehiculoMarcaSeleccionada;
        var colorFinal = _nuevoVehiculoColorSeleccionado == OtraOpcionMarcaColor ? _nuevoVehiculoColor : _nuevoVehiculoColorSeleccionado;

        if (string.IsNullOrWhiteSpace(marcaFinal)
            || string.IsNullOrWhiteSpace(_nuevoVehiculoModelo)
            || string.IsNullOrWhiteSpace(colorFinal)
            || string.IsNullOrWhiteSpace(_nuevoVehiculoAvisarA))
        {
            _errorNuevoVehiculo = "Completá Marca, Modelo, Color y a quién avisar.";
            return;
        }

        _errorNuevoVehiculo = null;
        _creandoVehiculo = true;

        Guid vehiculoId;
        try
        {
            vehiculoId = await Sender.Send(new RegistrarVehiculoCommand(
                marcaFinal,
                _nuevoVehiculoModelo,
                colorFinal,
                _nuevoVehiculoDominioCerteza,
                _nuevoVehiculoAccionARealizar,
                _nuevoVehiculoAvisarA,
                TipoVehiculo.Auto,
                string.IsNullOrWhiteSpace(_nuevoVehiculoDominio) ? null : _nuevoVehiculoDominio,
                string.IsNullOrWhiteSpace(_nuevoVehiculoCaracteristicas) ? null : _nuevoVehiculoCaracteristicas,
                null,
                _nuevoVehiculoCategoriasAlertaIds));
        }
        catch (EntidadDuplicadaException ex)
        {
            _errorNuevoVehiculo = ex.Message;
            _creandoVehiculo = false;
            return;
        }
        catch (Exception)
        {
            _errorNuevoVehiculo = "No se pudo crear el Vehículo. Verificá los datos e intentá de nuevo.";
            _creandoVehiculo = false;
            return;
        }

        // El Vehículo ya quedó creado y persistido en el paso anterior — si
        // falla acá, no repetir "no se pudo crear": el usuario tiene que
        // saber que ya existe (para no reintentar y duplicarlo) y que solo
        // falta vincularlo, buscándolo por Dominio en esta misma pantalla.
        try
        {
            await Sender.Send(new VincularVehiculoInformeCommand(InformeId, vehiculoId));
            _informe = await Sender.Send(new ObtenerInformePorIdQuery(InformeId));

            CancelarNuevoVehiculo();
        }
        catch (Exception)
        {
            _errorNuevoVehiculo = "El Vehículo se creó correctamente, pero no se pudo vincular a este Informe " +
                "(puede que el Informe haya cambiado de estado mientras tanto). Buscalo por Dominio arriba para vincularlo.";
        }
        finally
        {
            _creandoVehiculo = false;
        }
    }

    private void CancelarNuevaPersona()
    {
        _mostrandoNuevaPersona = false;
        _nuevaPersonaRol = RolPersona.Testigo;
        _nuevaPersonaNombre = null;
        _nuevaPersonaDni = null;
        _nuevaPersonaCaracteristicas = null;
        _errorNuevaPersona = null;
    }

    private async Task CrearYVincularPersonaAsync()
    {
        if (string.IsNullOrWhiteSpace(_nuevaPersonaNombre) && string.IsNullOrWhiteSpace(_nuevaPersonaCaracteristicas))
        {
            _errorNuevaPersona = "Completá el Nombre, o las Características si la Persona no está identificada.";
            return;
        }

        _errorNuevaPersona = null;
        _creandoPersona = true;

        Guid personaId;
        try
        {
            personaId = await Sender.Send(new RegistrarPersonaCommand(
                _nuevaPersonaRol,
                string.IsNullOrWhiteSpace(_nuevaPersonaNombre) ? null : _nuevaPersonaNombre,
                string.IsNullOrWhiteSpace(_nuevaPersonaDni) ? null : _nuevaPersonaDni,
                string.IsNullOrWhiteSpace(_nuevaPersonaCaracteristicas) ? null : _nuevaPersonaCaracteristicas));
        }
        catch (EntidadDuplicadaException ex)
        {
            _errorNuevaPersona = ex.Message;
            _creandoPersona = false;
            return;
        }
        catch (Exception)
        {
            _errorNuevaPersona = "No se pudo crear la Persona. Verificá los datos e intentá de nuevo.";
            _creandoPersona = false;
            return;
        }

        // La Persona ya quedó creada y persistida en el paso anterior — si
        // falla acá, no repetir "no se pudo crear": el usuario tiene que
        // saber que ya existe (para no reintentar y duplicarla) y que solo
        // falta vincularla, buscándola por DNI en esta misma pantalla.
        try
        {
            await Sender.Send(new VincularPersonaInformeCommand(InformeId, personaId));
            _informe = await Sender.Send(new ObtenerInformePorIdQuery(InformeId));

            CancelarNuevaPersona();
        }
        catch (Exception)
        {
            _errorNuevaPersona = "La Persona se creó correctamente, pero no se pudo vincular a este Informe " +
                "(puede que el Informe haya cambiado de estado mientras tanto). Buscala por DNI arriba para vincularla.";
        }
        finally
        {
            _creandoPersona = false;
        }
    }

    private async Task GuardarAsync()
    {
        _errorMessage = null;
        _guardando = true;

        try
        {
            await Sender.Send(new EditarInformeCommand(
                InformeId,
                _relato,
                string.IsNullOrWhiteSpace(_dependenciaDestinoId) ? null : Guid.Parse(_dependenciaDestinoId),
                _causaCaratula,
                _piezaSumarial,
                _circunscripcion,
                _fechaAnalisis,
                _idRegistro));

            NavigationManager.NavigateTo($"informes/{InformeId}");
        }
        catch (EntidadDuplicadaException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (FluentValidation.ValidationException ex)
        {
            _errorMessage = string.Join(" ", ex.Errors.Select(e => e.ErrorMessage));
        }
        catch (Exception)
        {
            _errorMessage = "No se pudieron guardar los cambios. Verificá los datos e intentá de nuevo.";
        }
        finally
        {
            _guardando = false;
        }
    }
}
