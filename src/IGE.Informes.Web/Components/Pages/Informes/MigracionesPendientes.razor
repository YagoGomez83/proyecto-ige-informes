@page "/informes/migrar/pendientes"
@attribute [Authorize]
@using IGE.Informes.Application.Common.Security
@using IGE.Informes.Application.Informes.Commands.CrearInformeDesdeMigracionPendiente
@using IGE.Informes.Application.Informes.Queries.ListarMigracionesPendientes
@using IGE.Informes.Application.Informes.Queries.ReprocesarMigracionPendiente
@using IGE.Informes.Application.Informes.Queries.SugerirCausas
@using MediatR
@inject ISender Sender
@inject NavigationManager NavigationManager

<PageTitle>Migraciones pendientes · IGE 4.0</PageTitle>

<h1 class="headline-md mb-3">Migraciones pendientes</h1>

<p class="body-sm mb-3">
    PDFs históricos a los que les falta el ID Registro y/o la Fecha de Análisis — completá lo
    que falte para crear el Informe, sin volver a subir el archivo.
</p>

@if (_errorMessage is not null)
{
    <div class="status-chip status-chip--alert mb-3">@_errorMessage</div>
}

@if (_migraciones is null)
{
    <p class="body-md">Cargando...</p>
}
else if (_migraciones.Count == 0)
{
    <p class="body-md">No hay migraciones pendientes por completar.</p>
}
else
{
    <div class="card">
        <table class="table">
            <thead>
                <tr>
                    <th class="label-md">ID Registro</th>
                    <th class="label-md">Causa</th>
                    <th class="label-md">Fecha de análisis</th>
                    <th class="label-md"></th>
                    <th class="label-md"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var migracion in _migraciones)
                {
                    <tr>
                        <td class="body-sm mono-data">
                            @if (migracion.IdRegistro is not null)
                            {
                                @migracion.IdRegistro
                            }
                            else
                            {
                                <input type="text" class="form-control mono-data" placeholder="Ej: 290/2026"
                                       value="@ObtenerIdRegistroIngresado(migracion.Id)"
                                       @onchange="@(e => ActualizarIdRegistroIngresado(migracion.Id, e.Value?.ToString()))" />
                            }
                        </td>
                        <td class="body-sm">
                            @(migracion.CausaCaratula ?? "—")
                            @if (ObtenerCausaSeleccionada(migracion.Id) is { } causaElegida)
                            {
                                <div class="mt-1">
                                    <span class="status-chip status-chip--safe">
                                        Vinculada a: @causaElegida.Caratula (@(causaElegida.NroPiezaSumarial ?? "sin pieza sumarial"))
                                    </span>
                                    <button type="button" class="btn-secondary mt-1 d-block" @onclick="@(() => QuitarCausaSeleccionada(migracion.Id))">Quitar</button>
                                </div>
                            }
                            else if (ObtenerSugerenciasCausa(migracion.Id) is { } sugerencias)
                            {
                                @if (sugerencias.Count > 0)
                                {
                                    <div class="mt-1">
                                        <p class="label-md mb-1">Causas existentes parecidas:</p>
                                        @foreach (var sugerencia in sugerencias)
                                        {
                                            <button type="button" class="btn-secondary mb-1 d-block"
                                                    @onclick="@(() => ElegirCausaSugerida(migracion.Id, sugerencia))">
                                                @sugerencia.Caratula
                                                <span class="mono-data">(@(sugerencia.NroPiezaSumarial ?? "sin pieza sumarial"))</span>
                                            </button>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="body-sm mt-1">Sin Causas parecidas en el catálogo.</p>
                                }
                            }
                            else if (!string.IsNullOrWhiteSpace(migracion.CausaCaratula))
                            {
                                <button type="button" class="btn-secondary mt-1 d-block"
                                        @onclick="@(() => MostrarSugerenciasDeCausaAsync(migracion))">
                                    Buscar Causas parecidas
                                </button>
                            }
                        </td>
                        <td class="body-sm">
                            <input type="date" class="form-control"
                                   value="@ObtenerFechaIngresada(migracion.Id)"
                                   @onchange="@(e => ActualizarFechaIngresada(migracion.Id, e.Value?.ToString()))" />
                        </td>
                        <td class="body-sm">
                            <button type="button" class="btn-secondary d-block mb-1"
                                    @onclick="@(() => AlternarVisorPdf(migracion.Id))">
                                @(_migracionIdConVisorAbierto == migracion.Id ? "Ocultar PDF" : "Ver PDF")
                            </button>
                            <button type="button" class="btn-secondary d-block"
                                    @onclick="@(() => ReintentarAsync(migracion))"
                                    disabled="@(_reprocesando.Contains(migracion.Id))"
                                    title="Volver a leer el PDF con el parser actualizado">
                                @(_reprocesando.Contains(migracion.Id) ? "Reintentando..." : "Reintentar")
                            </button>
                        </td>
                        <td class="body-sm">
                            <button type="button" class="btn-primary"
                                    @onclick="@(() => CompletarAsync(migracion))"
                                    disabled="@(_procesando || !PuedeCompletar(migracion))">
                                Completar
                            </button>
                        </td>
                    </tr>
                    @if (_migracionIdConVisorAbierto == migracion.Id)
                    {
                        <tr>
                            <td colspan="5">
                                <iframe src="@migracion.PdfUrl" class="migracion-pendiente-pdf-visor" title="Vista previa del PDF de la migración pendiente"></iframe>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyCollection<MigracionPendienteDto>? _migraciones;
    private readonly Dictionary<Guid, string> _fechasIngresadas = [];
    private readonly Dictionary<Guid, string> _idsRegistroIngresados = [];
    private readonly Dictionary<Guid, IReadOnlyCollection<CausaSugeridaDto>> _sugerenciasCausaPorMigracion = [];
    private readonly Dictionary<Guid, CausaSugeridaDto> _causaSeleccionadaPorMigracion = [];
    private bool _procesando;
    private string? _errorMessage;
    private Guid? _migracionIdConVisorAbierto;
    private readonly HashSet<Guid> _reprocesando = [];

    private void AlternarVisorPdf(Guid id)
    {
        _migracionIdConVisorAbierto = _migracionIdConVisorAbierto == id ? null : id;
    }

    // Vuelve a leer el PDF ya guardado con la versión actual del parser
    // (ver ReprocesarMigracionPendienteQuery) — no persiste nada por sí
    // solo, solo precarga los campos que todavía faltan para que el usuario
    // confirme con "Completar" como siempre. Existe porque el parser se
    // sigue corrigiendo con el tiempo (ver docs/06-seguridad-amenazas.md) y
    // las Migraciones Pendientes ya creadas no se benefician solas de esos
    // fixes sin volver a subir el archivo.
    private async Task ReintentarAsync(MigracionPendienteDto migracion)
    {
        _reprocesando.Add(migracion.Id);
        _errorMessage = null;

        try
        {
            var resultado = await Sender.Send(new ReprocesarMigracionPendienteQuery(migracion.Id));

            if (migracion.IdRegistro is null && resultado.IdRegistro is not null)
            {
                ActualizarIdRegistroIngresado(migracion.Id, resultado.IdRegistro);
            }

            if (resultado.FechaAnalisis is not null)
            {
                ActualizarFechaIngresada(migracion.Id, resultado.FechaAnalisis.Value.ToString("yyyy-MM-dd"));
            }

            if (resultado.IdRegistro is null && resultado.FechaAnalisis is null)
            {
                _errorMessage = "El reintento no reconoció ningún dato nuevo en el PDF.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "No se pudo reprocesar el PDF. Intentá de nuevo.";
        }
        finally
        {
            _reprocesando.Remove(migracion.Id);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _migraciones = await Sender.Send(new ListarMigracionesPendientesQuery());
    }

    // Sugerencias por similitud de carátula (pg_trgm, mismo motor que Editar
    // Informe usa) cargadas bajo demanda por fila, no todas juntas al abrir
    // la pantalla — con cientos de Migraciones Pendientes reales, disparar
    // una query similarity() por cada una al cargar sería una ráfaga de
    // consultas a Postgres sin ningún tope (hallazgo del security-reviewer).
    // No se filtra por Pieza Sumarial acá (a diferencia de
    // BuscarSugerenciasDeCausaAsync en Editar.razor) porque en esta pantalla
    // el auto-match exacto ya corre server-side al completar — estas
    // sugerencias son solo para el caso en que ese auto-match no encuentre
    // nada.
    private async Task MostrarSugerenciasDeCausaAsync(MigracionPendienteDto migracion)
    {
        if (string.IsNullOrWhiteSpace(migracion.CausaCaratula) || _sugerenciasCausaPorMigracion.ContainsKey(migracion.Id))
        {
            return;
        }

        var sugerencias = await Sender.Send(new SugerirCausasQuery(migracion.CausaCaratula));
        _sugerenciasCausaPorMigracion[migracion.Id] = sugerencias;
    }

    private IReadOnlyCollection<CausaSugeridaDto>? ObtenerSugerenciasCausa(Guid migracionId) =>
        _sugerenciasCausaPorMigracion.GetValueOrDefault(migracionId);

    private CausaSugeridaDto? ObtenerCausaSeleccionada(Guid migracionId) =>
        _causaSeleccionadaPorMigracion.GetValueOrDefault(migracionId);

    private void ElegirCausaSugerida(Guid migracionId, CausaSugeridaDto sugerencia)
    {
        _causaSeleccionadaPorMigracion[migracionId] = sugerencia;
    }

    private void QuitarCausaSeleccionada(Guid migracionId)
    {
        _causaSeleccionadaPorMigracion.Remove(migracionId);
    }

    private string ObtenerFechaIngresada(Guid id) => _fechasIngresadas.GetValueOrDefault(id, string.Empty);

    private string ObtenerIdRegistroIngresado(Guid id) => _idsRegistroIngresados.GetValueOrDefault(id, string.Empty);

    private void ActualizarFechaIngresada(Guid id, string? valor)
    {
        if (string.IsNullOrWhiteSpace(valor))
        {
            _fechasIngresadas.Remove(id);
        }
        else
        {
            _fechasIngresadas[id] = valor;
        }
    }

    private void ActualizarIdRegistroIngresado(Guid id, string? valor)
    {
        if (string.IsNullOrWhiteSpace(valor))
        {
            _idsRegistroIngresados.Remove(id);
        }
        else
        {
            _idsRegistroIngresados[id] = valor.Trim();
        }
    }

    private bool PuedeCompletar(MigracionPendienteDto migracion)
    {
        var tieneFecha = !string.IsNullOrWhiteSpace(ObtenerFechaIngresada(migracion.Id));
        var tieneIdRegistro = migracion.IdRegistro is not null || !string.IsNullOrWhiteSpace(ObtenerIdRegistroIngresado(migracion.Id));
        return tieneFecha && tieneIdRegistro;
    }

    private async Task CompletarAsync(MigracionPendienteDto migracion)
    {
        if (!DateOnly.TryParse(ObtenerFechaIngresada(migracion.Id), out var fechaAnalisis))
        {
            _errorMessage = "Ingresá una Fecha de Análisis válida.";
            return;
        }

        var idRegistroIngresado = ObtenerIdRegistroIngresado(migracion.Id);
        if (migracion.IdRegistro is null && string.IsNullOrWhiteSpace(idRegistroIngresado))
        {
            _errorMessage = "Ingresá el ID Registro.";
            return;
        }

        _errorMessage = null;
        _procesando = true;

        try
        {
            var causaSeleccionada = ObtenerCausaSeleccionada(migracion.Id);
            var informeId = await Sender.Send(new CrearInformeDesdeMigracionPendienteCommand(
                migracion.Id, fechaAnalisis, string.IsNullOrWhiteSpace(idRegistroIngresado) ? null : idRegistroIngresado, causaSeleccionada?.Id));
            NavigationManager.NavigateTo($"informes/{informeId}");
        }
        catch (Exception)
        {
            _errorMessage = "No se pudo completar la migración. Verificá los datos e intentá de nuevo.";
        }
        finally
        {
            _procesando = false;
        }
    }
}
