@page "/informes/{InformeId:guid}"
@attribute [Authorize]
@using IGE.Informes.Application.Informes.Commands.EliminarInforme
@using IGE.Informes.Application.Informes.Commands.PublicarInforme
@using IGE.Informes.Application.Informes.Commands.VincularPersonaInforme
@using IGE.Informes.Application.Informes.Commands.VincularVehiculoInforme
@using IGE.Informes.Application.Informes.Queries.ObtenerInformePorId
@using IGE.Informes.Application.Personas.Queries.BuscarPersonas
@using IGE.Informes.Application.Vehiculos.Queries.BuscarVehiculos
@using IGE.Informes.Application.Vehiculos.Queries.ListarVehiculos
@using IGE.Informes.Domain.Entities
@using MediatR
@inject ISender Sender
@inject NavigationManager NavigationManager

<PageTitle>Detalle de Informe · IGE 4.0</PageTitle>

@if (!_cargado)
{
    <p class="body-md">Cargando...</p>
}
else if (_informe is null)
{
    <p class="body-md">No se encontró el informe solicitado.</p>
}
else
{
    @if (_errorMessage is not null)
    {
        <div class="status-chip status-chip--alert mb-3">@_errorMessage</div>
    }

    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h1 class="headline-md mb-1 mono-data">@_informe.IdRegistro</h1>
            @if (_informe.Estado == EstadoInforme.Publicado)
            {
                <StatusChip Texto="Publicado" Semantica="ChipSemantica.Safe" />
            }
            else
            {
                <StatusChip Texto="Borrador" Semantica="ChipSemantica.Warning" />
            }
        </div>
        <div class="d-flex gap-2">
            @if (_informe.Estado == EstadoInforme.Borrador)
            {
                <a class="btn-secondary" href="@($"informes/{_informe.Id}/editar")">Editar</a>
            }
            @if (_informe.CasoAnalisisId is not null)
            {
                <a class="btn-secondary" href="@($"casos/{_informe.CasoAnalisisId}")">Ver Caso de origen</a>
            }
            @if (_informe.Estado != EstadoInforme.Publicado)
            {
                <AuthorizeView Roles="Supervisor,Admin">
                    <Authorized>
                        <button type="button" class="btn-destructive" @onclick="() => _mostrarConfirmacionEliminar = true">Eliminar</button>
                    </Authorized>
                </AuthorizeView>
            }
        </div>
    </div>

    <div class="card mb-3">
        <h2 class="headline-sm mb-2">Datos generales</h2>
        <dl class="row mb-0">
            @if (_informe.Origen == OrigenInforme.Migrado)
            {
                <dt class="col-sm-3 label-md">Origen</dt>
                <dd class="col-sm-9 body-md">Migrado desde histórico (sin Caso de Análisis asociado)</dd>
            }

            <dt class="col-sm-3 label-md">Fecha de análisis</dt>
            <dd class="col-sm-9 body-md">@_informe.FechaAnalisis.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-3 label-md">Carátula de la Causa</dt>
            <dd class="col-sm-9 body-md">@(_informe.CausaCaratula ?? "—")</dd>
        </dl>
    </div>

    <div class="row g-3">
        <div class="col-lg-6">
            <div class="card h-100">
                <h2 class="headline-sm mb-2">Relato</h2>
                @if (string.IsNullOrWhiteSpace(_informe.Relato))
                {
                    <p class="body-md mb-0">—</p>
                }
                else
                {
                    <p class="body-md mb-0 informe-relato-texto">@_informe.Relato</p>
                }
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card h-100 p-0">
                <h2 class="headline-sm m-3 mb-2">PDF</h2>
                @if (_informe.PdfUrl is not null)
                {
                    <iframe src="@_informe.PdfUrl" class="informe-pdf-visor" title="Vista previa del PDF del Informe"></iframe>
                }
                else
                {
                    <p class="body-md mx-3 mb-3">Pendiente de carga.</p>
                }
            </div>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-lg-6">
            <div class="card h-100">
                <h2 class="headline-sm mb-2">Vehículos vinculados</h2>
                @if (_informe.VehiculosVinculados.Count == 0)
                {
                    <p class="body-md">Ningún vehículo vinculado todavía.</p>
                }
                else
                {
                    <ul class="mb-3">
                        @foreach (var vehiculo in _informe.VehiculosVinculados)
                        {
                            <li class="body-sm">
                                <a href="@($"vehiculos/{vehiculo.Id}")">@vehiculo.Marca @vehiculo.Modelo</a>
                                @if (vehiculo.Dominio is not null)
                                {
                                    <span class="mono-data"> — @vehiculo.Dominio</span>
                                }
                            </li>
                        }
                    </ul>
                }

                @if (_informe.Estado == EstadoInforme.Borrador)
                {
                    <div class="d-flex gap-2">
                        <input class="form-control mono-data" @bind="_dominioBuscado" @bind:event="oninput" placeholder="Buscar por dominio..." disabled="@_vinculando" />
                        <button type="button" class="btn-secondary" @onclick="BuscarVehiculosAsync" disabled="@_vinculando">Buscar</button>
                    </div>

                    @if (_resultadosVehiculos is not null)
                    {
                        @if (_resultadosVehiculos.Count == 0)
                        {
                            <p class="body-sm mt-2 mb-0">Sin resultados.</p>
                        }
                        else
                        {
                            <ul class="mt-2 mb-0">
                                @foreach (var resultado in _resultadosVehiculos)
                                {
                                    <li class="body-sm">
                                        @resultado.Marca @resultado.Modelo (@resultado.Dominio)
                                        <button type="button" class="btn-secondary" @onclick="() => VincularVehiculoAsync(resultado.Id)" disabled="@_vinculando">Vincular</button>
                                    </li>
                                }
                            </ul>
                        }
                    }
                }
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card h-100">
                <h2 class="headline-sm mb-2">Personas vinculadas</h2>
                @if (_informe.PersonasVinculadas.Count == 0)
                {
                    <p class="body-md">Ninguna persona vinculada todavía.</p>
                }
                else
                {
                    <ul class="mb-3">
                        @foreach (var persona in _informe.PersonasVinculadas)
                        {
                            <li class="body-sm">
                                <a href="@($"personas/{persona.Id}")">@(persona.Nombre ?? "Sin identificar")</a>
                                @if (persona.Dni is not null)
                                {
                                    <span class="mono-data"> — @persona.Dni</span>
                                }
                            </li>
                        }
                    </ul>
                }

                @if (_informe.Estado == EstadoInforme.Borrador)
                {
                    <div class="d-flex gap-2">
                        <input class="form-control mono-data" @bind="_dniBuscado" @bind:event="oninput" placeholder="Buscar por DNI..." disabled="@_vinculando" />
                        <button type="button" class="btn-secondary" @onclick="BuscarPersonasAsync" disabled="@_vinculando">Buscar</button>
                    </div>

                    @if (_resultadosPersonas is not null)
                    {
                        @if (_resultadosPersonas.Count == 0)
                        {
                            <p class="body-sm mt-2 mb-0">Sin resultados.</p>
                        }
                        else
                        {
                            <ul class="mt-2 mb-0">
                                @foreach (var resultado in _resultadosPersonas)
                                {
                                    <li class="body-sm">
                                        @(resultado.Nombre ?? "Sin identificar") (@(resultado.Dni ?? "sin DNI"))
                                        <button type="button" class="btn-secondary" @onclick="() => VincularPersonaAsync(resultado.Id)" disabled="@_vinculando">Vincular</button>
                                    </li>
                                }
                            </ul>
                        }
                    }
                }
            </div>
        </div>
    </div>

    @if (_informe.Estado == EstadoInforme.Borrador)
    {
        <div class="d-flex justify-content-end mt-3">
            <button type="button" class="btn-primary" @onclick="() => _mostrarConfirmacionPublicar = true" disabled="@_publicando">Publicar</button>
        </div>
    }

    <ConfirmacionModal Visible="_mostrarConfirmacionPublicar"
                        Titulo="Publicar Informe"
                        Mensaje="@($"¿Confirmás publicar el Informe {_informe.IdRegistro}? Una vez publicado queda inmutable y no se puede volver a editar.")"
                        TextoConfirmar="Publicar"
                        Procesando="_publicando"
                        OnConfirmar="PublicarAsync"
                        OnCancelar="() => _mostrarConfirmacionPublicar = false" />

    <ConfirmacionModal Visible="_mostrarConfirmacionEliminar"
                        Titulo="Eliminar Informe"
                        Mensaje="@($"¿Confirmás eliminar el Informe {_informe.IdRegistro}? El registro deja de aparecer en listados y búsquedas, pero se conserva para auditoría.")"
                        TextoConfirmar="Eliminar"
                        Procesando="_eliminando"
                        OnConfirmar="EliminarAsync"
                        OnCancelar="() => _mostrarConfirmacionEliminar = false" />
}

@code {
    [Parameter]
    public Guid InformeId { get; set; }

    private InformeDto? _informe;
    private bool _cargado;
    private bool _publicando;
    private bool _mostrarConfirmacionPublicar;
    private bool _mostrarConfirmacionEliminar;
    private bool _eliminando;
    private string? _errorMessage;

    private string _dominioBuscado = string.Empty;
    private string _dniBuscado = string.Empty;
    private IReadOnlyCollection<VehiculoResumenDto>? _resultadosVehiculos;
    private IReadOnlyCollection<PersonaBusquedaResultDto>? _resultadosPersonas;
    private bool _vinculando;

    protected override async Task OnInitializedAsync()
    {
        _informe = await Sender.Send(new ObtenerInformePorIdQuery(InformeId));
        _cargado = true;
    }

    private async Task BuscarVehiculosAsync()
    {
        if (string.IsNullOrWhiteSpace(_dominioBuscado) || _dominioBuscado.Trim().Length < 3)
        {
            _errorMessage = "Ingresá al menos 3 caracteres para buscar.";
            return;
        }

        _errorMessage = null;
        _resultadosVehiculos = await Sender.Send(new BuscarVehiculosQuery(_dominioBuscado));
    }

    private async Task BuscarPersonasAsync()
    {
        if (string.IsNullOrWhiteSpace(_dniBuscado) || _dniBuscado.Trim().Length < 3)
        {
            _errorMessage = "Ingresá al menos 3 caracteres para buscar.";
            return;
        }

        _errorMessage = null;
        _resultadosPersonas = await Sender.Send(new BuscarPersonasQuery(_dniBuscado));
    }

    private async Task VincularVehiculoAsync(Guid vehiculoId)
    {
        _errorMessage = null;
        _vinculando = true;

        try
        {
            await Sender.Send(new VincularVehiculoInformeCommand(InformeId, vehiculoId));
            _resultadosVehiculos = null;
            _dominioBuscado = string.Empty;
            _informe = await Sender.Send(new ObtenerInformePorIdQuery(InformeId));
        }
        catch (Exception)
        {
            _errorMessage = "No se pudo vincular el vehículo.";
        }
        finally
        {
            _vinculando = false;
        }
    }

    private async Task VincularPersonaAsync(Guid personaId)
    {
        _errorMessage = null;
        _vinculando = true;

        try
        {
            await Sender.Send(new VincularPersonaInformeCommand(InformeId, personaId));
            _resultadosPersonas = null;
            _dniBuscado = string.Empty;
            _informe = await Sender.Send(new ObtenerInformePorIdQuery(InformeId));
        }
        catch (Exception)
        {
            _errorMessage = "No se pudo vincular la persona.";
        }
        finally
        {
            _vinculando = false;
        }
    }

    private async Task PublicarAsync()
    {
        _errorMessage = null;
        _publicando = true;

        try
        {
            await Sender.Send(new PublicarInformeCommand(InformeId));
            NavigationManager.NavigateTo($"informes/{InformeId}", forceLoad: true);
        }
        catch (InvalidOperationException ex)
        {
            _mostrarConfirmacionPublicar = false;
            _errorMessage = ex.Message;
        }
        catch (Exception)
        {
            _mostrarConfirmacionPublicar = false;
            _errorMessage = "No se pudo publicar el Informe. Verificá que tenga Causa y Dependencia completas.";
        }
        finally
        {
            _publicando = false;
        }
    }

    private async Task EliminarAsync()
    {
        _errorMessage = null;
        _eliminando = true;

        try
        {
            await Sender.Send(new EliminarInformeCommand(InformeId));
            NavigationManager.NavigateTo("informes");
        }
        catch (InvalidOperationException ex)
        {
            _mostrarConfirmacionEliminar = false;
            _errorMessage = ex.Message;
        }
        catch (Exception)
        {
            _mostrarConfirmacionEliminar = false;
            _errorMessage = "No se pudo eliminar el Informe.";
        }
        finally
        {
            _eliminando = false;
        }
    }
}
