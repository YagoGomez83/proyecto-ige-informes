:443 {
	# on_demand: el sitio no tiene un hostname fijo (se accede por IP LAN,
	# ver docs/07-plan-despliegue.md — sin dominio ni CA institucional), así
	# que "tls internal" a secas no sabe para qué nombre pre-generar el
	# certificado y el handshake falla con "no certificate available" para
	# cualquier SNI real (localhost, la IP, etc). on_demand emite el
	# certificado la primera vez que llega un ClientHello con ese nombre.
	tls internal {
		on_demand
	}

	# Content-Security-Policy NO se define acá: la app .NET la arma
	# (CspMiddleware.cs) porque necesita el hash SHA-256 del ImportMap de
	# Blazor, calculado a partir de los assets con fingerprint del build
	# actual — ver docs/06-seguridad-amenazas.md. El resto de los security
	# headers, que sí son estáticos, se quedan en Caddy.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
	}

	reverse_proxy web:8080
}

# TLS para el tráfico directo del navegador a MinIO (URLs prefirmadas del
# visor de PDF/imágenes, ver Minio__EndpointPublico) — MinIO en sí solo
# habla HTTP en la red interna de Docker (minio:9000), pero la CSP de la
# app tiene "upgrade-insecure-requests" (CspMiddleware.cs), así que el
# navegador reescribe cualquier URL http:// de esta página a https://
# antes de pedirla. Sin este listener, esa reescritura apunta a un puerto
# que no responde TLS y el handshake falla (bug real: PDFs migrados
# mostraban "ha enviado una respuesta no válida" al intentar visualizarse,
# ver project_bug_pdfpath_migracion_2026-08-11 en memoria).
:9000 {
	tls internal {
		on_demand
	}

	# Mismos headers estáticos que :443 salvo X-Frame-Options: el visor de
	# PDF de la app carga este origen dentro de un <iframe> a propósito
	# (Detalle.razor), así que "DENY" acá rompería esa vista previa sin
	# aportar protección real (X-Frame-Options protege que ESTE origen no
	# se embeba en un frame ajeno, no al revés).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
	}

	reverse_proxy minio:9000
}
