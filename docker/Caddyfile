:443 {
	# on_demand: el sitio no tiene un hostname fijo (se accede por IP LAN,
	# ver docs/07-plan-despliegue.md — sin dominio ni CA institucional), así
	# que "tls internal" a secas no sabe para qué nombre pre-generar el
	# certificado y el handshake falla con "no certificate available" para
	# cualquier SNI real (localhost, la IP, etc). on_demand emite el
	# certificado la primera vez que llega un ClientHello con ese nombre.
	tls internal {
		on_demand
	}

	# Content-Security-Policy NO se define acá: la app .NET la arma
	# (CspMiddleware.cs) porque necesita el hash SHA-256 del ImportMap de
	# Blazor, calculado a partir de los assets con fingerprint del build
	# actual — ver docs/06-seguridad-amenazas.md. El resto de los security
	# headers, que sí son estáticos, se quedan en Caddy.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
	}

	reverse_proxy web:8080
}
