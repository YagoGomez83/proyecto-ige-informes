:443 {
	# on_demand: el sitio no tiene un hostname fijo (se accede por IP LAN,
	# ver docs/07-plan-despliegue.md — sin dominio ni CA institucional), así
	# que "tls internal" a secas no sabe para qué nombre pre-generar el
	# certificado y el handshake falla con "no certificate available" para
	# cualquier SNI real (localhost, la IP, etc). on_demand emite el
	# certificado la primera vez que llega un ClientHello con ese nombre.
	tls internal {
		on_demand
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		# img-src/frame-src acotados al origen público de MinIO (no un
		# wildcard ni relajación de default-src): habilitan tanto las
		# imágenes de Vehículo/Persona (<img src> en Detalle.razor) como el
		# visor de PDF embebido en Informes/Detalle.razor, que cargan desde
		# una URL prefirmada de MinIO (otro origen/puerto que el resto de la
		# app, servida acá). Incluyen localhost:9000 (dev local) y la IP de
		# la VM de producción (192.168.70.50:9000, ver MINIO_ENDPOINT_PUBLICO
		# en docker-compose.yml) — ajustar si el host de MinIO cambia.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://localhost:9000 https://localhost:9000 http://192.168.70.50:9000; connect-src 'self' wss:; frame-src 'self' http://localhost:9000 https://localhost:9000 http://192.168.70.50:9000; frame-ancestors 'none'"
	}

	reverse_proxy web:8080
}
