ASPNETCORE_ENVIRONMENT=Production

POSTGRES_DB=ige_informes
POSTGRES_USER=ige_informes
POSTGRES_PASSWORD=CHANGE_ME

MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME

# Host:puerto por el que el NAVEGADOR del cliente accede a MinIO para
# descargar/previsualizar archivos (URLs prefirmadas) — distinto del
# hostname interno "minio:9000" que usa el backend. En desarrollo local
# el default "localhost:9000" ya alcanza. En producción, usar la IP/dominio
# real del servidor (ej. "192.168.70.198:9000") — requiere que el puerto
# 9000 de MinIO esté accesible desde la red donde estén los clientes.
MINIO_ENDPOINT_PUBLICO=localhost:9000

# Solo se usan para crear el primer usuario Admin si la tabla de usuarios
# está vacía. Una vez creado el primer Admin, se pueden quitar del .env.
IGE_ADMIN_EMAIL=admin@ige.local
IGE_ADMIN_PASSWORD=CHANGE_ME
